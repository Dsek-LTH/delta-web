# syntax=docker/dockerfile:1
FROM docker.io/oven/bun:1 AS base
WORKDIR /usr/src/app

# install all dependencies (drizzle-kit is a devDependency needed at runtime)
FROM base AS tools
COPY package.json bun.lock ./
RUN --mount=type=cache,target=/root/.bun/install/cache \
    bun install --frozen-lockfile --ignore-scripts
COPY ./drizzle.config.ts ./drizzle.config.ts
COPY ./tsconfig.json ./tsconfig.json
COPY ./src/db ./src/db
COPY ./src/index.ts ./src/index.ts
COPY ./src/envvars.ts ./src/envvars.ts
COPY ./src/constants.ts ./src/constants.ts

RUN mkdir -p /data && \
    chown -R bun:root /usr/src/app /data && \
    chmod -R g+rw /usr/src/app /data

ENV DB_FILE_NAME=file:/data/local.db

USER bun
CMD ["sh", "-c", "bunx drizzle-kit migrate && bun run seed"]
