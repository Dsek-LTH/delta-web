# syntax=docker/dockerfile:1
FROM docker.io/oven/bun:1 AS base
WORKDIR /usr/src/app

# install dependencies into temp directory
FROM base AS install
COPY package.json bun.lock /temp/
RUN --mount=type=cache,target=/root/.bun/install/cache \
    mkdir -p /temp/dev /temp/prod && \
    cp /temp/package.json /temp/bun.lock /temp/dev/ && \
    cp /temp/package.json /temp/bun.lock /temp/prod/ && \
    cd /temp/dev && bun install --frozen-lockfile --ignore-scripts && \
    cd /temp/prod && bun install --frozen-lockfile --production --ignore-scripts

# build app and bundle release artifacts
FROM base AS prerelease
COPY --from=install /temp/dev/node_modules node_modules
COPY . .
RUN bun run build && \
    mkdir -p /usr/src/app/release && \
    cp package.json bun.lock /usr/src/app/release/ && \
    cp -r dist /usr/src/app/release/

# production image with prod-only dependencies
FROM base AS release
COPY --from=install /temp/prod/node_modules ./node_modules
COPY --from=prerelease /usr/src/app/release ./

RUN rm -rf node_modules/@rolldown/binding-linux-x64-musl \
           node_modules/@img/sharp-libvips-linuxmusl-x64 \
           node_modules/@img/sharp-linuxmusl-x64 \
           node_modules/lightningcss-linux-x64-musl \
           node_modules/@libsql/linux-x64-musl \
           node_modules/@tailwindcss/oxide-linux-x64-musl && \
    mkdir -p /data && \
    chown -R bun:root /usr/src/app /data && \
    chmod -R g+rw /usr/src/app /data

ENV DB_FILE_NAME=file:/data/local.db

USER bun
EXPOSE 8080/tcp
CMD ["bun", "dist/server/entry.mjs"]
