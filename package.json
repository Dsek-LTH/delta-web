{
  "name": "delta-web",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "astro": "astro",
    "format:fix": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src/**/*{.ts,.js,.astro} --no-error-on-unmatched-pattern",
    "generate": "bunx drizzle-kit generate",
    "migrate": "mkdir -p data && bunx drizzle-kit migrate",
    "seed": "bun run src/index.ts",
    "seed:reset": "bun run src/seed-reset.ts",
    "preinstall": "cp --update=none .env.example .env 2>/dev/null || true",
    "preview": "bun astro build && bun dist/server/entry.mjs",
    "postinstall": "bunx lefthook install"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@lucide/astro": "^1.22.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.1",
    "@wyattjoh/astro-bun-adapter": "^2.1.0",
    "astro": "^7.0.0",
    "astro-icon": "^1.1.5",
    "better-auth": "^1.6.23",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^1.0.0-rc.4",
    "prettier": "^3.8.4",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@typescript-eslint/parser": "^8.62.1",
    "bun-types": "^1.3.14",
    "drizzle-kit": "^1.0.0-rc.4",
    "eslint": "^10.6.0",
    "eslint-plugin-astro": "^2.1.1",
    "lefhook": "^1.1.1",
    "tsx": "^4.22.4"
  }
}
