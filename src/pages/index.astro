---
import Layout from "@/layouts/Layout.astro";
import Card from "@/components/Card.astro";
import { MapPin, Users } from "@lucide/astro";
import Logo from "@/components/Logo.astro";
import Countdown from "@/components/Countdown.astro";
import { languages } from "@/i18n/ui.ts";
import { i18n, getRenderedContent } from "@/i18n/utils";
import { fairDate } from "@/constants";
import { getEntry } from "astro:content";
import cover from "@/assets/tekfok26_0003.webp";

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang, translate: t } = i18n(Astro.cookies);

const whatIs = await getRenderedContent(getEntry, lang, "landing-what-is");
---

<Layout
  title={t("landing.head.title")}
  description={t("landing.head.description")}
  backgroundImage={cover}
  class="flex flex-col items-center gap-12 pb-12 px-6 mx-auto w-full max-w-7xl lg:px-16"
>
  <div class="text-center text-shadow-md/25">
    <h1 aria-label="DELTA" role="img" class="contents text-7xl lg:text-9xl">
      <Logo animate inverse />
    </h1>
    <Countdown class="text-white lg:text-4xl text-2xl" />
  </div>

  <div class="flex flex-col gap-8 w-full max-w-110 lg:max-w-none">
    <div class="grid gap-8 w-full lg:grid-cols-5">
      <Card
        class="lg:col-span-3 p-8 lg:p-10 flex flex-col justify-center gap-8"
      >
        <div class="flex flex-col gap-2">
          <h2
            class="text-2xl font-bold uppercase tracking-tight text-brand-primary"
          >
            {t("landing.card.when")}
          </h2>
          <p class="text-3xl font-bold leading-tight lg:text-5xl">
            {
              fairDate.toLocaleDateString(lang, {
                weekday: "long",
                year: "numeric",
                month: "long",
                day: "numeric",
              })
            }
          </p>
          <p class="text-xl text-card-content-muted lg:text-2xl">08:00–17:00</p>
        </div>
        <p class="flex items-center gap-3 text-card-content-muted">
          <Users class="size-5 shrink-0" />
          <span>{t("landing.card.when.networking")}</span>
        </p>
      </Card>

      <Card class="lg:col-span-2 p-0 flex flex-col">
        <div class="flex flex-col gap-2 p-8 pb-6">
          <h2
            class="text-2xl font-bold uppercase tracking-tight text-brand-primary"
          >
            {t("landing.card.where")}
          </h2>
          <p class="text-xl font-semibold">E-Huset, LTH</p>
          <p class="flex items-start gap-2 text-sm text-card-content-muted">
            <MapPin class="mt-0.5 size-4 shrink-0" />
            <span>
              Ole Römers väg 3, 223 63 Lund, {t("landing.card.where.sweden")}
            </span>
          </p>
        </div>
        <iframe
          class="min-h-56 w-full flex-1 border-0"
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d1001.2498072316307!2d13.209636197891264!3d55.711069045083036!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x465397ca158a6165%3A0x7f9339d3824e88ee!2sOle%20R%C3%B6mers%20v%C3%A4g%203%2C%20223%2063%20Lund!5e0!3m2!1ssv!2sse!4v1665410976182!5m2!1ssv!2sse"
          title={t("landing.card.where.map.title")}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        >
          E-huset LTH Ole Römers väg 3.
        </iframe>
      </Card>
    </div>

    <Card class="p-8 lg:p-12">
      <div
        class="flex flex-col gap-6 lg:grid lg:grid-cols-[auto_1fr] lg:items-start lg:gap-16"
      >
        <h2
          class="text-4xl font-bold uppercase tracking-tight text-brand-primary lg:text-5xl"
        >
          {t("landing.card.what")}
        </h2>
        <div class="prose leading-relaxed">
          {whatIs && <div set:html={whatIs.html} />}
        </div>
      </div>
    </Card>
  </div>

  <a
    href="mailto:delta@dsek.se"
    target="_blank"
    class="frosted-glass text-card-content font-bold py-4 px-8 rounded-full lg:text-5xl text-3xl flex items-center lg:gap-8 gap-4 no-underline transition-colors duration-200 hover:bg-card-highlight"
  >
    <span>{t("landing.button.attend")}</span>
    <Logo />
  </a>
</Layout>
