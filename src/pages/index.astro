---
import Layout from "@/layouts/Layout.astro";
import Attendees from "@/components/sections/Attendees.astro";
import Companies from "@/components/sections/Companies.astro";
import Hero from "@/components/sections/Hero.astro";
import ProjectGroup from "@/components/sections/ProjectGroup.astro";
import Students from "@/components/sections/Students.astro";
import { i18n } from "@/i18n/utils";

const { translate: t } = i18n(Astro);
---

<Layout
  title={t("landing.head.title")}
  description={t("landing.head.description")}
  class="w-full"
>
  <Hero />
  <Attendees />
  <Companies />
  <Students />
  <ProjectGroup />
</Layout>
