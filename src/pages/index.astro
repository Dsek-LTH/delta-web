<script>
  const detailButtons = document.querySelectorAll<HTMLButtonElement>(
    "[data-tier-details]",
  );
  const hosts = document.querySelectorAll<HTMLElement>(
    "[data-tier-panel-host]",
  );
  const panels = document.querySelectorAll<HTMLElement>("[data-tier-panel]");

  const setActive = (activeId: string | undefined) => {
    panels.forEach((panel) => {
      panel.inert = panel.dataset.tierPanel !== activeId;
    });
    detailButtons.forEach((button) => {
      button.setAttribute(
        "aria-expanded",
        String(button.dataset.tierDetails === activeId),
      );
    });
  };

  const closeHost = (host: HTMLElement) => {
    host.removeAttribute("data-open");
    window.setTimeout(() => {
      if (!host.hasAttribute("data-open")) host.hidden = true;
    }, 350);
  };

  const closePanels = () => {
    hosts.forEach(closeHost);
    setActive(undefined);
  };

  const openPanel = (tierId: string) => {
    const target = [...panels].find(
      (panel) => panel.dataset.tierPanel === tierId,
    );
    const host = target?.closest<HTMLElement>("[data-tier-panel-host]");
    if (!target || !host) return;

    // Only one group's panel is open at a time; others close instantly.
    hosts.forEach((other) => {
      if (other !== host) {
        other.removeAttribute("data-open");
        other.hidden = true;
      }
    });

    panels.forEach((panel) => {
      panel.hidden = panel !== target;
    });
    setActive(tierId);

    host.hidden = false;
    if (!host.hasAttribute("data-open")) {
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          host.setAttribute("data-open", "");
        });
      });
    }

    window.setTimeout(() => {
      if (host.hasAttribute("data-open")) {
        target.scrollIntoView({ behavior: "smooth", block: "nearest" });
      }
    }, 340);
  };

  detailButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const id = button.dataset.tierDetails;
      const target = [...panels].find(
        (panel) => panel.dataset.tierPanel === id,
      );
      const host = target?.closest<HTMLElement>("[data-tier-panel-host]");
      const isOpen =
        !!host &&
        host.hasAttribute("data-open") &&
        !host.hidden &&
        !!target &&
        !target.hidden;

      if (isOpen) {
        closePanels();
      } else {
        openPanel(id ?? "");
      }
    });
  });

  document
    .querySelectorAll<HTMLButtonElement>("[data-tier-close]")
    .forEach((button) => {
      button.addEventListener("click", closePanels);
    });
</script>
