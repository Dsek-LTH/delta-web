---
import AuthButton from "@/components/AuthButton.astro";
import Layout from "@/layouts/Layout.astro";
import propaganda from "@/assets/propaganda.mp4";

const loggedIn = Astro.locals.session;

import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout description={t("admin.title")}>
  <div class="flex flex-col justify-start flex-1 w-full gap-8 p-30 px-60">
    <h1 class="text-3xl font-bold">{t("admin.title")}</h1>
    {
      loggedIn ? (
        <div>
          <p class="text-balance">{t("admin.welcome")}</p>
          <video class="w-full max-w-3xl rounded-lg" controls autoplay loop>
            <source src={propaganda} type="video/mp4" />
          </video>
        </div>
      ) : (
        <p>{t("admin.login-prompt")}</p>
      )
    }
    <AuthButton />
  </div>
</Layout>
