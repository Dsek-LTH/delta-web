---
import AuthButton from "@/components/AuthButton.astro";
import Layout from "@/layouts/Layout.astro";
import propaganda from "@/assets/propaganda.mp4";
import { i18n } from "@/i18n/utils";

const loggedIn = Astro.locals.session;

const { lang, translate: t } = await i18n(Astro.url);
---

<Layout description={t("admin.title")}>
  <div class="flex flex-col justify-start flex-1 w-full gap-8 p-30 px-60">
    <h1 class="text-3xl font-bold">{t("admin.title")}</h1>
    {
      loggedIn ? (
        <div class="flex flex-col gap-4">
          <p class="text-balance">{t("admin.welcome")}</p>
          <a
            class="btn btn-primary frosted-glass text-brand-secondary rounded-2xl hover:bg-card/80 hover:scale-[1.01] hover:shadow-black/70 transition-all duration-300 ease-out w-fit px-4 py-2 bg-card/50"
            href={`/${lang}/admin/delta-force`}
          >
            {t("admin.panel.delta-force")}
          </a>
          <video class="w-full max-w-3xl rounded-lg" controls autoplay loop>
            <source src={propaganda} type="video/mp4" />
          </video>
        </div>
      ) : (
        <p>{t("admin.login-prompt")}</p>
      )
    }
    <div class="flex gap-4 justify-left">
      <AuthButton />
      <a
        class="btn btn-primary frosted-glass text-brand-secondary rounded-2xl hover:bg-card/80 hover:scale-[1.01] hover:shadow-black/70 transition-all duration-300 ease-out w-fit px-4 py-2 bg-card/50"
        href={`/${lang}/`}
      >
        {t("admin.back")}
      </a>
    </div>
  </div>
</Layout>
