---

<Layout
  title={t("company.head.title")}
  description={t("company.head.description")}
  class="flex flex-col items-center gap-16 px-6 py-16 mx-auto max-w-7xl lg:gap-20 lg:px-16"
>
  <section
    class="frosted-glass w-full max-w-5xl rounded-2xl px-6 py-12 text-center lg:px-16 lg:py-16"
  >
    <h1 class="text-4xl font-bold text-card-content lg:text-6xl">
      <Logo animate />
      <span class="ms-[0.5em] italic">{t("company.hero.forCompanies")}</span>
    </h1>

    <p class="mt-16 text-xl font-bold text-brand-primary lg:mt-20 lg:text-2xl">
      {t("company.hero.meetDevelopers")}
    </p>
    <p class="mt-6 font-mono text-sm text-card-content-muted">
      {t("company.hero.fields")}
    </p>
    <p class="mt-10 text-card-content-muted lg:mt-12">
      {t("company.hero.contactBefore")}{" "}
      <a
        href="mailto:delta@dsek.se"
        class="font-semibold text-brand-primary underline transition-colors hover:text-brand-primary/80"
        >delta@dsek.se</a
      >{" "}
      {t("company.hero.contactAfter")}
    </p>
  </section>

  <section id="pricing" class="flex w-full scroll-mt-28 flex-col gap-10">
    <div class="flex flex-col items-center gap-4 text-center">
      <h2
        class="text-5xl font-bold uppercase tracking-tight text-center text-brand-primary"
      >
        {t("company.pricing.title")}
      </h2>
      <p class="max-w-3xl leading-relaxed text-card-content">
        {t("company.pricing.subtitle")}
      </p>
    </div>

    <div class="grid w-full gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        tiers.map((tier) => (
          <Package
            class={`border-0 border-t-4 p-6 shadow-lg ${tier.accent} ${tier.glow}`}
          >
            <PackageTitle title={tier.name} class={`text-3xl ${tier.color}`} />
            <div class="flex flex-col gap-1">
              <p class="text-center font-mono text-2xl font-bold tabular-nums text-card-content">
                {tier.price}
              </p>
              {tier.discount && (
                <p class="text-center font-mono text-xs text-card-content-muted">
                  {tier.discount}
                </p>
              )}
            </div>
            <p class="text-center text-sm leading-relaxed text-card-content-muted">
              {tier.intro}
            </p>
            <ul class="mt-2 flex flex-col gap-2.5 text-sm text-card-content">
              {tier.highlights.map((highlight) => (
                <li class="flex items-start gap-2">
                  <Check class={`mt-0.5 size-4 shrink-0 ${tier.color}`} />
                  <span>{highlight}</span>
                </li>
              ))}
            </ul>
            <div class="mt-auto flex flex-col items-center gap-3">
              <button
                type="button"
                data-tier-details={tier.id}
                aria-expanded="false"
                aria-controls={`tier-details-${tier.id}`}
                class="group flex items-center gap-1 text-sm font-semibold text-brand-primary transition-colors hover:text-brand-primary/80"
              >
                {t("company.package.showDetails")}
                <ChevronDown class="size-4 transition-transform duration-300 group-aria-expanded:rotate-180" />
              </button>
              <a
                href="mailto:delta@dsek.se"
                class={`rounded-full px-5 ${tier.cta}`}
              >
                {t("company.package.contact")}
              </a>
            </div>
          </Package>
        ))
      }
    </div>

    <div
      data-tier-panel-host
      hidden
      class="tier-panel-wrap w-full scroll-mt-28"
    >
      <div class="tier-panel">
        {
          tiers.map((tier) => (
            <section
              id={`tier-details-${tier.id}`}
              data-tier-panel={tier.id}
              inert
              hidden
              class={`frosted-glass w-full rounded-2xl border-t-4 p-8 lg:p-10 ${tier.accent}`}
            >
              <div class="flex items-start justify-between gap-6">
                <div>
                  <h3 class={`text-3xl font-extrabold ${tier.color}`}>
                    {tier.name}
                  </h3>
                  <p class="mt-2 font-mono text-xl font-bold tabular-nums text-card-content">
                    {tier.price}
                  </p>
                  {tier.discount && (
                    <p class="mt-1 font-mono text-xs text-card-content-muted">
                      {tier.discount}
                    </p>
                  )}
                </div>
                <button
                  type="button"
                  data-tier-close
                  aria-label={t("company.package.hideDetails")}
                  class="btn btn-ghost rounded-full p-2"
                >
                  <X class="size-5" />
                </button>
              </div>
              <p class="mt-4 text-lg font-bold text-card-content">
                {tier.intro}
              </p>
              {tier.subtitle && (
                <p class="mt-3 leading-relaxed text-card-content-muted">
                  {tier.subtitle}
                </p>
              )}
              <p class="mt-6 font-extrabold text-card-content">
                {t("company.package.guarantees")}
              </p>
              <ul class="delta-bullets mt-4 grid gap-x-10 gap-y-3 text-sm text-card-content lg:grid-cols-2">
                {tier.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
              {tier.closing && (
                <p class="mt-6 text-sm leading-relaxed text-card-content-muted">
                  {tier.closing}
                </p>
              )}
              <a
                href="mailto:delta@dsek.se"
                class={`mt-8 rounded-full px-6 ${tier.cta}`}
              >
                {t("company.package.contact")}
              </a>
            </section>
          ))
        }
      </div>
    </div>

    <PricingTable />
  </section>
</Layout>

<script>
  const detailButtons = document.querySelectorAll<HTMLButtonElement>(
    "[data-tier-details]",
  );
  const host = document.querySelector<HTMLElement>("[data-tier-panel-host]");
  const panels = host?.querySelectorAll<HTMLElement>("[data-tier-panel]");

  const setActive = (activeId: string | undefined) => {
    panels?.forEach((panel) => {
      panel.inert = panel.dataset.tierPanel !== activeId;
    });
    detailButtons.forEach((button) => {
      button.setAttribute(
        "aria-expanded",
        String(button.dataset.tierDetails === activeId),
      );
    });
  };

  const closePanel = () => {
    if (!host) return;
    host.removeAttribute("data-open");
    setActive(undefined);

    // Hide the collapsed host once the fold animation is done. The timeout
    // (rather than transitionend) avoids child transitions consuming the
    // event and leaving the host stuck open.
    window.setTimeout(() => {
      if (!host.hasAttribute("data-open")) host.hidden = true;
    }, 350);
  };

  const openPanel = (tierId: string) => {
    const target = host?.querySelector<HTMLElement>(
      `[data-tier-panel="${tierId}"]`,
    );
    if (!host || !target) return;

    panels?.forEach((panel) => {
      panel.hidden = panel !== target;
    });
    setActive(tierId);

    host.hidden = false;
    if (!host.hasAttribute("data-open")) {
      // Wait two frames so the collapsed state paints before expanding.
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          host.setAttribute("data-open", "");
        });
      });
    }

    // Scroll once the unfold has finished so the panel's real height is known;
    // "nearest" moves the page the minimum needed.
    window.setTimeout(() => {
      if (host.hasAttribute("data-open")) {
        target.scrollIntoView({ behavior: "smooth", block: "nearest" });
      }
    }, 340);
  };

  detailButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const id = button.dataset.tierDetails;
      const isOpen =
        host?.hasAttribute("data-open") &&
        host.querySelector(`[data-tier-panel="${id}"]:not([hidden])`);

      if (isOpen) {
        closePanel();
      } else {
        openPanel(id ?? "");
      }
    });
  });

  document
    .querySelectorAll<HTMLButtonElement>("[data-tier-close]")
    .forEach((button) => {
      button.addEventListener("click", closePanel);
    });
</script>
