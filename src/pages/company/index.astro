---
import Layout from "@/layouts/Layout.astro";
import Package from "@/components/company/Package.astro";
import PackageTitle from "@/components/company/PackageTitle.astro";
import PricingTable from "@/components/company/PricingTable.astro";
import Logo from "@/components/Logo.astro";
import { i18n } from "@/i18n/utils";

const { translate: t } = i18n(Astro);
---

<Layout
  title={t("company.head.title")}
  description={t("company.head.description")}
  class="flex flex-col items-center gap-12 px-6 py-12 mx-auto max-w-7xl lg:px-16"
>
  <section class="frosted-glass text-center p-4 rounded-xl">
    <h1 class="text-5xl font-bold italic text-card-content p-4">
      <Logo class="mr-6" />
      {t("company.hero.forCompanies")}
    </h1>

    <article>
      <h2 class="text-brand-primary text-xl font-bold">
        {t("company.hero.meetDevelopers")}
      </h2>
      <p class="text-card-content mt-5">
        {t("company.hero.contactBefore")}{" "}
        <a
          href="mailto:delta@dsek.se"
          class="text-brand-primary font-bold underline transition-colors hover:text-brand-primary/80"
          >delta@dsek.se</a
        >{" "}
        {t("company.hero.contactAfter")}
      </p>
    </article>
  </section>

  <div class="grid lg:grid-cols-4 gap-8">
    <Package
      class="lg:col-span-2 border-bronze shadow-[0_0_15px_3px] shadow-bronze/80 hover:shadow-bronze"
    >
      <PackageTitle title="Startup" class="text-bronze" />
      <div class="flex flex-col gap-5 text-base leading-relaxed">
        <p class="text-lg font-bold text-card-content">
          {t("company.package.startup.intro")}
        </p>
        <p class="text-card-content">
          {t("company.package.startup.subtitle")}
        </p>
        <p class="text-lg font-extrabold text-card-content">
          {t("company.package.guarantees")}
        </p>
        <ul class="delta-bullets flex flex-col gap-2.5 text-card-content">
          <li>{t("company.package.startup.booth")}</li>
          <li>{t("company.package.startup.tableStool")}</li>
          <li>{t("company.package.startup.afterParty")}</li>
          <li>{t("company.package.startup.lounge")}</li>
          <li>{t("company.package.startup.wardrobe")}</li>
          <li>{t("company.package.startup.wifi")}</li>
        </ul>
      </div>
    </Package>
    <Package
      class="lg:col-span-2 border-gold shadow-[0_0_15px_3px] shadow-gold/80 hover:shadow-gold"
    >
      <PackageTitle title="Delta" class="text-gold" />
      <div class="flex flex-col gap-5 text-base leading-relaxed">
        <p class="text-lg font-bold text-card-content">
          {t("company.package.delta.intro")}
        </p>
        <p class="text-card-content">
          {t("company.package.delta.subtitle")}
        </p>
        <p class="text-lg font-extrabold text-card-content">
          {t("company.package.guarantees")}
        </p>
        <ul class="delta-bullets flex flex-col gap-2.5 text-card-content">
          <li>{t("company.package.delta.booth")}</li>
          <li>{t("company.package.delta.tableStool")}</li>
          <li>{t("company.package.delta.afterParty")}</li>
          <li>{t("company.package.delta.lunch")}</li>
          <li>{t("company.package.delta.parking")}</li>
          <li>{t("company.package.delta.lounge")}</li>
          <li>{t("company.package.delta.wardrobe")}</li>
          <li>{t("company.package.delta.host")}</li>
          <li>{t("company.package.delta.wifi")}</li>
        </ul>
      </div>
    </Package>
    <Package
      class="lg:col-span-2 border-silver shadow-[0_0_15px_3px] shadow-silver/80 hover:shadow-silver"
    >
      <PackageTitle title="Delta++" class="text-silver" />
      <div class="flex flex-col gap-5 text-base leading-relaxed">
        <p class="text-lg font-bold text-card-content">
          {t("company.package.deltaPlusPlus.intro")}
        </p>
        <p class="text-card-content">
          {t("company.package.deltaPlusPlus.subtitle")}
        </p>
        <p class="text-lg font-extrabold text-card-content">
          {t("company.package.guarantees")}
        </p>
        <ul class="delta-bullets flex flex-col gap-2.5 text-card-content">
          <li>{t("company.package.deltaPlusPlus.basePackage")}</li>
          <li>{t("company.package.deltaPlusPlus.caseEvening")}</li>
          <li>{t("company.package.deltaPlusPlus.studentSessions")}</li>
          <li>{t("company.package.deltaPlusPlus.centralBooth")}</li>
        </ul>
      </div>
    </Package>

    <Package
      class="lg:col-span-2 border-amethyst shadow-[0_0_15px_3px] shadow-amethyst/80 hover:shadow-amethyst"
    >
      <PackageTitle title="Delta#" class="text-amethyst" />
      <div class="flex flex-col gap-5 text-base leading-relaxed">
        <p class="text-lg font-bold text-card-content">
          {t("company.package.deltaSharp.intro")}
        </p>
        <p class="text-card-content">
          {t("company.package.deltaSharp.subtitle")}
        </p>
        <p class="text-lg font-extrabold text-card-content">
          {t("company.package.guarantees")}
        </p>
        <ul class="delta-bullets flex flex-col gap-2.5 text-card-content">
          <li>{t("company.package.deltaSharp.basePackage")}</li>
          <li>{t("company.package.deltaSharp.lunchLecture")}</li>
          <li>{t("company.package.deltaSharp.boothChoice")}</li>
        </ul>
      </div>
    </Package>

    <Package
      class="lg:col-span-2 border-diamond shadow-[0_0_15px_3px] shadow-diamond/80 hover:shadow-diamond"
    >
      <PackageTitle title="Non-profit" class="text-diamond" />
      <div class="flex flex-col gap-5 text-base leading-relaxed">
        <p class="text-lg font-bold text-card-content">
          {t("company.package.nonprofit.intro")}
        </p>
        <p class="text-card-content">
          {t("company.package.nonprofit.subtitle")}
        </p>
        <p class="text-lg font-extrabold text-card-content">
          {t("company.package.guarantees")}
        </p>
        <ul class="delta-bullets flex flex-col gap-2.5 text-card-content">
          <li>{t("company.package.nonprofit.booth")}</li>
          <li>{t("company.package.nonprofit.tableStool")}</li>
          <li>{t("company.package.nonprofit.afterParty")}</li>
          <li>{t("company.package.nonprofit.lounge")}</li>
          <li>{t("company.package.nonprofit.wardrobe")}</li>
          <li>{t("company.package.nonprofit.wifi")}</li>
        </ul>
      </div>
    </Package>
  </div>

  <PricingTable />
</Layout>
