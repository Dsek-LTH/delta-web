---
import Layout from "@/layouts/Layout.astro";
import Package from "@/components/company/Package.astro";
import PackageTitle from "@/components/company/PackageTitle.astro";
import PricingTable from "@/components/company/PricingTable.astro";
import Logo from "@/components/Logo.astro";
import { Check } from "@lucide/astro";
import { languages } from "@/i18n/ui.ts";
import { i18n } from "@/i18n/utils";

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { translate: t } = i18n(Astro.cookies);

const tiers = [
  {
    id: "nonprofit",
    name: t("company.pricing.tier.nonprofit"),
    price: t("company.pricing.price.nonprofit"),
    intro: t("company.package.nonprofit.intro"),
    accent: "border-diamond",
    color: "text-diamond",
    glow: "shadow-diamond/20",
    cta: "btn btn-ghost",
    highlights: [
      t("company.pricing.row.booth"),
      t("company.pricing.row.table"),
      t("company.pricing.row.logo"),
      t("company.pricing.row.wardrobeInfodesk"),
    ],
  },
  {
    id: "startup",
    name: t("company.pricing.tier.startup"),
    price: t("company.pricing.price.startup"),
    intro: t("company.package.startup.intro"),
    accent: "border-bronze",
    color: "text-bronze",
    glow: "shadow-bronze/20",
    cta: "btn btn-ghost",
    highlights: [
      t("company.pricing.row.booth"),
      t("company.pricing.row.table"),
      t("company.pricing.row.logo"),
      t("company.pricing.row.lounge"),
    ],
  },
  {
    id: "standard",
    name: t("company.pricing.tier.standard"),
    price: t("company.pricing.price.standard"),
    intro: t("company.package.standard.intro"),
    accent: "border-gold",
    color: "text-gold",
    glow: "shadow-gold/20",
    cta: "btn btn-ghost",
    highlights: [
      t("company.pricing.row.booth"),
      t("company.pricing.row.lunch"),
      t("company.pricing.row.parking"),
      t("company.pricing.row.lounge"),
    ],
  },
  {
    id: "main",
    name: t("company.pricing.tier.main"),
    price: t("company.pricing.price.main"),
    intro: t("company.package.main.intro"),
    accent: "border-emerald",
    color: "text-emerald",
    glow: "shadow-emerald/20",
    cta: "btn bg-emerald text-white hover:bg-emerald/85 dark:text-slate-950",
    highlights: [
      t("company.pricing.row.boothPlacement"),
      t("company.pricing.row.tv"),
      t("company.pricing.row.social"),
      t("company.pricing.row.priorityHeadSponsor"),
    ],
  },
];
---

<Layout
  title={t("company.head.title")}
  description={t("company.head.description")}
  class="flex flex-col items-center gap-16 px-6 py-16 mx-auto max-w-7xl lg:gap-20 lg:px-16"
>
  <section
    class="frosted-glass w-full max-w-5xl rounded-2xl px-6 py-12 text-center lg:px-16 lg:py-16"
  >
    <h1 class="text-4xl font-bold text-card-content lg:text-6xl">
      <Logo />
      <span class="italic">{t("company.hero.forCompanies")}</span>
    </h1>

    <p class="mt-6 text-xl font-bold text-brand-primary lg:text-2xl">
      {t("company.hero.meetDevelopers")}
    </p>
    <p class="mt-6 text-card-content-muted">
      {t("company.hero.contactBefore")}{" "}
      <a
        href="mailto:delta@dsek.se"
        class="font-semibold text-brand-primary underline transition-colors hover:text-brand-primary/80"
        >delta@dsek.se</a
      >{" "}
      {t("company.hero.contactAfter")}
    </p>
  </section>

  <div class="grid w-full gap-6 sm:grid-cols-2 lg:grid-cols-4">
    {
      tiers.map((tier) => (
        <Package
          class={`border-0 border-t-4 p-6 shadow-lg ${tier.accent} ${tier.glow}`}
        >
          <PackageTitle title={tier.name} class={`text-3xl ${tier.color}`} />
          <p class="text-center text-2xl font-bold text-card-content">
            {tier.price}
          </p>
          <p class="text-center text-sm leading-relaxed text-card-content-muted">
            {tier.intro}
          </p>
          <ul class="mt-2 flex flex-col gap-2.5 text-sm text-card-content">
            {tier.highlights.map((highlight) => (
              <li class="flex items-start gap-2">
                <Check class={`mt-0.5 size-4 shrink-0 ${tier.color}`} />
                <span>{highlight}</span>
              </li>
            ))}
          </ul>
          <a
            href="mailto:delta@dsek.se"
            class={`mx-auto mt-auto rounded-full px-5 ${tier.cta}`}
          >
            {t("company.package.contact")}
          </a>
        </Package>
      ))
    }
  </div>

  <PricingTable />
</Layout>
