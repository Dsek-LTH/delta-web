---
import Card from "@/components/Card.astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { twMerge } from "tailwind-merge";
import PhotoPlaceholder from "./PhotoPlaceholder.astro";

interface Member {
  firstName: string;
  lastName: string;
  email: string;
  linkedin: string;
  github: string | null;
}

interface Props {
  label: string;
  members: Member[];
  photo: ImageMetadata | null;
  span?: 1 | 2 | 3;
  startRight?: boolean;
}

const { label, members, photo, span = 1, startRight = false } = Astro.props;

// Fixed media heights keep photo areas level across tiles in the same row
// (wide and single tiles share the same height; the full-width tile is taller).
const media = span === 3 ? "h-64 lg:h-96" : "h-56 lg:h-72";
---

<Card
  class={twMerge(
    "overflow-hidden p-0",
    span === 3 && "lg:col-span-3",
    span === 2 && "lg:col-span-2",
    startRight && "lg:col-start-2",
  )}
>
  {
    photo ? (
      <Image
        src={photo}
        alt=""
        width={800}
        height={600}
        class={twMerge("w-full object-cover", media)}
      />
    ) : (
      <PhotoPlaceholder
        kind={members.length > 1 ? "group" : "profile"}
        class={media}
      />
    )
  }
  <div class="flex flex-col gap-3 p-6">
    <h3 class="flex items-baseline gap-3 text-xl font-bold text-brand-primary">
      <span class="font-mono">&gt;</span>
      {label}
      <span class="font-mono text-sm font-normal text-card-content-muted">
        {String(members.length).padStart(2, "0")}
      </span>
    </h3>
    <ul
      class="flex w-full flex-wrap items-start justify-center gap-x-4 gap-y-2 text-center text-base font-semibold"
    >
      {
        members.map((member) => (
          <li class="flex min-w-24 flex-1 flex-col items-center gap-0.5 sm:min-w-28">
            <a
              href={member.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="text-card-content transition-colors hover:text-brand-primary"
            >
              {member.firstName} {member.lastName}
            </a>
            <span class="flex items-center gap-1.5 text-xs font-normal text-card-content-muted">
              <a
                href={`mailto:${member.email}`}
                class="transition-colors hover:text-brand-primary"
              >
                {member.email}
              </a>
              <a
                href={member.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`LinkedIn – ${member.firstName} ${member.lastName}`}
                class="transition-colors hover:text-brand-primary"
              >
                <svg
                  viewBox="0 0 24 24"
                  class="size-3.5 shrink-0"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                </svg>
              </a>
              {member.github && (
                <a
                  href={member.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`GitHub – ${member.firstName} ${member.lastName}`}
                  class="transition-colors hover:text-brand-primary"
                >
                  <svg
                    viewBox="0 0 24 24"
                    class="size-3.5 shrink-0"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
                  </svg>
                </a>
              )}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</Card>
