---
import Card from "@/components/Card.astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { twMerge } from "tailwind-merge";
import PhotoPlaceholder from "./PhotoPlaceholder.astro";

interface Member {
  firstName: string;
  lastName: string;
  linkedin: string;
}

interface Props {
  label: string;
  members: Member[];
  photo: ImageMetadata | null;
  span?: 1 | 2 | 3;
  startRight?: boolean;
}

const { label, members, photo, span = 1, startRight = false } = Astro.props;

const aspect =
  span === 3
    ? "aspect-video lg:aspect-[21/9]"
    : span === 2
      ? "aspect-4/3 lg:aspect-video"
      : "aspect-4/3";
---

<Card
  class={twMerge(
    "overflow-hidden p-0",
    span === 3 && "lg:col-span-3",
    span === 2 && "lg:col-span-2",
    startRight && "lg:col-start-2",
  )}
>
  {
    photo ? (
      <Image
        src={photo}
        alt=""
        width={800}
        height={600}
        class={twMerge("w-full object-cover", aspect)}
      />
    ) : (
      <PhotoPlaceholder
        kind={members.length > 1 ? "group" : "profile"}
        class={aspect}
      />
    )
  }
  <div class="flex flex-col gap-3 p-6">
    <h3 class="flex items-baseline gap-3 text-xl font-bold text-brand-primary">
      <span class="font-mono">&gt;</span>
      {label}
      <span class="font-mono text-sm font-normal text-card-content-muted">
        {String(members.length).padStart(2, "0")}
      </span>
    </h3>
    <ul
      class="flex w-full flex-wrap items-start justify-center gap-x-4 gap-y-2 text-center text-base font-semibold"
    >
      {
        members.map((member) => (
          <li class="min-w-24 flex-1 sm:min-w-28">
            <a
              href={member.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="text-card-content transition-colors hover:text-brand-primary"
            >
              {member.firstName} {member.lastName}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Card>
