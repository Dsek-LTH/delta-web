---
import { Image } from "astro:assets";
import { i18n } from "@/i18n/utils";
import { deltaForceTable } from "@/db/schema";
import { getMemberImage } from "@/files/client";
import { deltaFordeRoleToTranslationKey } from "@/constants";
import DefaultProfileImage from "@/assets/default-profile.webp";

const { translate: t } = await i18n(Astro.cookies);

const { member, showRole } = Astro.props as {
  member: typeof deltaForceTable.$inferSelect;
  showRole?: boolean;
};

const memberImage = await getMemberImage(member).catch(
  () => DefaultProfileImage,
);
---

<li
  class="frosted-glass flex flex-col gap-2 items-center p-4 rounded-lg bg-highlight/80 hover:bg-card/80 transition-all duration-300 ease-out"
>
  {
    showRole && (
      <span class="italic font-normal w-full sm:text-center text-left">
        {t(deltaFordeRoleToTranslationKey(member.role, false))}
      </span>
    )
  }
  <div class="flex flex-row sm:flex-col gap-4 items-center">
    <Image
      src={memberImage}
      alt={t("admin.delta-force.member.picture")}
      width={500}
      height={500}
      class="lg:w-[16vw] sm:w-[20vw] sm:max-w-none max-w-1/3 aspect-square object-cover rounded-lg lg:order-1"
    />
    <p class="flex flex-col gap-1 order-2 text-left sm:text-center">
      <a
        href={member.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="font-bold"
      >
        {member.firstName}
        {member.lastName}
      </a>
      <a
        href={`mailto:${member.email}`}
        class="text-sm text-brand-secondary hover:text-backdrop-content-highlight/80"
      >
        {member.email}
      </a>
    </p>
  </div>
</li>
