---
import Layout from "@/layouts/Layout.astro";
import { i18n } from "@/i18n/utils";
import { db } from "@/db/connect";
import { deltaForceTable } from "@/db/schema";
import MemberCard from "./MemberCard.astro";
import Logo from "@/components/Logo.astro";

const deltaForceMembers = await db.select().from(deltaForceTable).all();

const { translate: t } = await i18n(Astro.cookies);
---

<Layout
  title={t("delta-force.title")}
  description={t("delta-force.meta.description")}
>
  <div
    class="flex flex-col justify-start items-center flex-1 w-full gap-8 p-8 lg:p-30 lg:px-60"
  >
    <div
      class="flex lg:flex-row flex-col justify-between gap-8 w-full sm:text-left text-center"
    >
      <div class="flex flex-col justify-center items-start gap-4 lg:max-w-1/2">
        <h1 class="text-5xl font-bold text-left lg:text-6xl">
          <Logo animate command="--force" class="inline-block" />
        </h1>

        <p class="text-balance">
          {t("delta-force.description")}
        </p>
      </div>
      <div
        class="flex flex-col justify-center lg:items-start items-center gap-4"
      >
        <h2 class="text-3xl font-bold">{t("delta-force.generals")}</h2>
        <ul class="font-bold flex sm:flex-row flex-col gap-4 items-center">
          {
            deltaForceMembers
              .filter((member) => member.role === "general")
              .map((member) => <MemberCard member={member} />)
          }
        </ul>
      </div>
    </div>

    <h2 class="text-3xl font-bold">{t("delta-force.project-group")}</h2>
    <ul class="font-bold flex flex-wrap items-center justify-center gap-4">
      {
        deltaForceMembers
          .filter((member) => member.role != "general")
          .sort((a, b) => a.role.localeCompare(b.role))
          .map((member) => <MemberCard member={member} showRole={true} />)
      }
    </ul>
  </div>
</Layout>
