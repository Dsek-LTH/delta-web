---
import Layout from "@/layouts/Layout.astro";
import { i18n } from "@/i18n/utils";
import { db } from "@/db/connect";
import { deltaForceTable } from "@/db/schema";
import { deltaForceRoles, deltaFordeRoleToTranslationKey } from "@/constants";
import MemberCard from "./MemberCard.astro";
import Logo from "@/components/Logo.astro";
import Card from "@/components/Card.astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

const deltaForceMembers = await db.select().from(deltaForceTable).all();

const { translate: t } = await i18n(Astro.cookies);

// Drop team photos into src/assets/team/ and they are picked up automatically.
// Names: all (= whole team), it, event, finance, logistics, marketing, relations, staff.
const teamPhotos = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/team/*.{webp,jpg,jpeg,png}",
  { eager: true },
);
const photoFor = (name: string): ImageMetadata | null => {
  const entry = Object.entries(teamPhotos).find(([path]) =>
    new RegExp(`/${name}\\.(webp|jpe?g|png)$`).test(path),
  );
  return entry?.[1].default ?? null;
};

const allPhoto = photoFor("all") ?? photoFor("team");
const generals = deltaForceMembers.filter(
  (member) => member.role === "general",
);
const teams = deltaForceRoles
  .filter((role) => role !== "general")
  .map((role) => ({
    role,
    label: t(deltaFordeRoleToTranslationKey(role, true)),
    photo: photoFor(role),
    members: deltaForceMembers.filter((member) => member.role === role),
  }))
  .filter((team) => team.members.length > 0);
---

<Layout
  title={t("delta-force.title")}
  description={t("delta-force.meta.description")}
  class="flex flex-col items-center gap-16 px-6 py-16 mx-auto max-w-7xl lg:px-16"
>
  <Card class="relative w-full overflow-hidden p-0">
    {
      allPhoto ? (
        <>
          <Image
            src={allPhoto}
            alt=""
            width={1600}
            height={700}
            class="h-80 w-full object-cover lg:h-[26rem]"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950/85 via-slate-950/40 to-slate-950/10" />
          <div class="absolute inset-x-0 bottom-0 flex flex-col gap-3 p-6 lg:p-10">
            <h1 class="text-3xl font-bold sm:text-4xl lg:text-5xl">
              <Logo
                animate
                inverse
                command="--force"
                class="inline-block text-white"
              />
            </h1>
            <p class="max-w-3xl text-balance text-sm text-white/85 lg:text-base">
              {t("delta-force.description")}
            </p>
          </div>
        </>
      ) : (
        <div class="flex flex-col gap-4 p-8 lg:p-10">
          <h1 class="text-4xl font-bold sm:text-5xl lg:text-6xl">
            <Logo animate command="--force" class="inline-block" />
          </h1>
          <p class="max-w-3xl text-balance">{t("delta-force.description")}</p>
        </div>
      )
    }
  </Card>

  <section class="flex w-full flex-col gap-8">
    <h2 class="text-3xl font-bold">{t("delta-force.generals")}</h2>
    <ul class="flex flex-col items-center gap-4 font-bold sm:flex-row">
      {generals.map((member) => <MemberCard member={member} />)}
    </ul>
  </section>

  <section class="flex w-full flex-col gap-8">
    <h2 class="text-center text-3xl font-bold lg:text-4xl">
      {t("delta-force.project-group")}
    </h2>
    <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        teams.map((team) => (
          <Card class="overflow-hidden p-0">
            {team.photo ? (
              <Image
                src={team.photo}
                alt=""
                width={800}
                height={600}
                class="aspect-4/3 w-full object-cover"
              />
            ) : (
              <div class="grid aspect-4/3 w-full place-items-center bg-card-highlight/40 font-display text-8xl text-brand-primary/25">
                Δ
              </div>
            )}
            <div class="flex flex-col gap-3 p-6">
              <h3 class="flex items-baseline gap-3 text-xl font-bold text-brand-primary">
                <span class="font-mono">&gt;</span>
                {team.label}
                <span class="font-mono text-sm font-normal text-card-content-muted">
                  {String(team.members.length).padStart(2, "0")}
                </span>
              </h3>
              <ul class="flex flex-col gap-1 text-sm text-card-content">
                {team.members.map((member) => (
                  <li>
                    <a
                      href={member.linkedin}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-card-content hover:text-card-content-highlight"
                    >
                      {member.firstName} {member.lastName}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </Card>
        ))
      }
    </div>
  </section>
</Layout>
