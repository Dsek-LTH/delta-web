---
import { actions } from "astro:actions";
import Page from "../Page.astro";
import { eq } from "drizzle-orm";
import { db } from "@/db/connect";
import { deltaForceTable } from "@/db/schema";

const memberId = Astro.params.member;
const result = Astro.getActionResult(
  actions.deltaForceMember.updateDeltaForceMember,
);

if (result?.data?.studentId) {
  return Astro.redirect(`/admin/delta-force/${result.data.studentId}`);
}

let member = null;
if (memberId) {
  member = await db
    .select()
    .from(deltaForceTable)
    .where(eq(deltaForceTable.studentId, memberId))
    .get();
}
if (!member) {
  return Astro.redirect(`/admin/delta-force`);
}
---

<Page member={member} />
