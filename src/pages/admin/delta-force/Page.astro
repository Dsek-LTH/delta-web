---
import Layout from "@/layouts/Layout.astro";
import { i18n } from "@/i18n/utils";
import { deltaForceTable } from "@/db/schema";
import MemberEditor from "./MemberEditor.astro";
import MemberList from "./MemberList.astro";
import { ArrowLeft } from "@lucide/astro";

const { member, newMember, imageWarning } = Astro.props as {
  member: typeof deltaForceTable.$inferSelect;
  newMember?: boolean;
  imageWarning?: string;
};
const { translate: t } = i18n(Astro);
---

<Layout
  title={(member ? `${member.firstName} ${member.lastName}: ` : "") +
    t("admin.delta-force.title")}
  description={(member ? `${member.firstName} ${member.lastName}: ` : "") +
    t("admin.delta-force.description")}
>
  <div class="flex w-3/4 min-w-fit items-top gap-8 p-30">
    <a
      class="btn btn-primary frosted-glass flex items-center text-card-content rounded-xl aspect-square hover:bg-card/80 hover:scale-[1.01] hover:shadow-black/70 transition-all duration-300 ease-out w-fit h-fit p-1 bg-card/50"
      href={`/admin`}
    >
      <ArrowLeft class="w-6 h-6" />
    </a>
    <div class="flex flex-col justify-startflex-1 w-full gap-8">
      <div class="flex flex-wrap items-center gap-4">
        <h1 class="text-3xl font-bold">{t("admin.delta-force.title")}</h1>
        <a
          class="btn btn-primary frosted-glass text-card-content rounded-2xl hover:bg-card/80 hover:scale-[1.01] hover:shadow-black/70 transition-all duration-300 ease-out w-fit px-4 py-2 bg-card/50"
          href={`/admin/delta-force/groups`}
        >
          {t("admin.group-photos.link")}
        </a>
      </div>
      <div class="flex gap-8 w-full">
        <MemberList />
        {
          member && (
            <MemberEditor
              class="flex-1 h-fit"
              member={member}
              newMember={newMember}
              imageWarning={imageWarning}
            />
          )
        }
      </div>
    </div>
  </div>
</Layout>
