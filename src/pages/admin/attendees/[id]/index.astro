---
import { actions } from "astro:actions";
import Page from "../Page.astro";
import { eq } from "drizzle-orm";
import { db } from "@/db/connect";
import { attendeesTable } from "@/db/schema";
import {
  imageWarningFromQuery,
  withImageWarning,
} from "@/files/imageWarnings";

const attendeeId = Number(Astro.params.id);
const result = Astro.getActionResult(actions.attendee.updateAttendee);

if (result?.data?.id) {
  return Astro.redirect(
    withImageWarning(
      `/admin/attendees/${result.data.id}`,
      result.data.imageWarning,
    ),
  );
}

const imageWarning = imageWarningFromQuery(
  Astro.url.searchParams.get("imageWarning"),
);

let attendee = null;
if (Number.isInteger(attendeeId)) {
  attendee = await db
    .select()
    .from(attendeesTable)
    .where(eq(attendeesTable.id, attendeeId))
    .get();
}
if (!attendee) {
  return Astro.redirect(`/admin/attendees`);
}
---

<Page attendee={attendee} imageWarning={imageWarning} />
