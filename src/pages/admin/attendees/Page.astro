---
import Layout from "@/layouts/Layout.astro";
import { i18n } from "@/i18n/utils";
import { attendeesTable } from "@/db/schema";
import MemberEditor from "./MemberEditor.astro";
import MemberList from "./MemberList.astro";
import { ArrowLeft } from "@lucide/astro";

const { attendee, newAttendee, imageWarning } = Astro.props as {
  attendee: typeof attendeesTable.$inferSelect;
  newAttendee?: boolean;
  imageWarning?: string;
};
const { translate: t } = i18n(Astro);
---

<Layout
  title={(attendee ? `${attendee.name}: ` : "") + t("admin.attendees.title")}
  description={(attendee ? `${attendee.name}: ` : "") +
    t("admin.attendees.description")}
>
  <div class="flex w-3/4 min-w-fit items-top gap-8 p-30">
    <a
      class="btn btn-primary frosted-glass flex items-center text-card-content rounded-xl aspect-square hover:bg-card/80 hover:scale-[1.01] hover:shadow-black/70 transition-all duration-300 ease-out w-fit h-fit p-1 bg-card/50"
      href={`/admin`}
    >
      <ArrowLeft class="w-6 h-6" />
    </a>
    <div class="flex flex-col justify-startflex-1 w-full gap-8">
      <h1 class="text-3xl font-bold">{t("admin.attendees.title")}</h1>
      <div class="flex gap-8 w-full">
        <MemberList />
        {
          attendee && (
            <MemberEditor
              class="flex-1 h-fit"
              attendee={attendee}
              newAttendee={newAttendee}
              imageWarning={imageWarning}
            />
          )
        }
      </div>
    </div>
  </div>
</Layout>
