---
import { actions, isInputError } from "astro:actions";
import { twMerge } from "tailwind-merge";
import { i18n } from "@/i18n/utils";
import TextInput from "@/components/TextInput.astro";
import TextArea from "@/components/TextArea.astro";
import Label from "@/components/Label.astro";
import FileInput from "@/components/FileInput.astro";
import { getAttendeeImage } from "@/files/client";
import { attendeesTable } from "@/db/schema";
import { Image } from "astro:assets";
import DefaultProfileImage from "@/assets/default-profile.webp";

const {
  class: className,
  attendee,
  newAttendee,
} = Astro.props as {
  class: string;
  attendee: typeof attendeesTable.$inferSelect;
  newAttendee?: boolean;
};

const { lang, translate: t } = i18n(Astro);
const action = newAttendee
  ? actions.attendee.addAttendee
  : actions.attendee.updateAttendee;
const result = Astro.getActionResult(action);
const inputErrors = isInputError(result?.error) ? result.error.fields : null;
const actionError =
  result?.error && !isInputError(result.error) ? result.error : null;
const inputErrorEntries = inputErrors
  ? (Object.entries(inputErrors as Record<string, string[]>) as Array<
      [string, string[]]
    >)
  : [];
const attendeeImage: ImageMetadata = await getAttendeeImage(attendee).catch(
  () => DefaultProfileImage,
);
---

<form
  class={twMerge(
    "flex flex-col gap-4 h-fit w-full frosted-glass p-4 rounded-lg bg-card/50 transition-all duration-300 ease-out",
    className,
  )}
  action={action}
  method="POST"
  enctype="multipart/form-data"
>
  {newAttendee || <input type="hidden" name="id" value={attendee.id} />}
  <input type="hidden" name="lang" value={lang} />
  {
    (actionError || inputErrors) && (
      <div class="rounded-lg border border-red-500/40 bg-red-500/10 p-3 text-sm text-red-200">
        <p class="font-semibold">Could not save attendee</p>
        {actionError && (
          <p class="mt-1">
            {actionError.message ?? "An unknown error occurred."}
          </p>
        )}
        {inputErrors && (
          <ul class="mt-2 list-disc pl-5">
            {inputErrorEntries.map(([field, messages]) => (
              <li>
                <span class="font-medium">{field}:</span> {messages.join(", ")}
              </li>
            ))}
          </ul>
        )}
      </div>
    )
  }
  <div class="flex flex-col gap-1">
    <Label name="name" label={t("admin.attendees.attendee.name")} />
    <TextInput name="name" value={attendee.name} />
  </div>
  <div class="flex flex-col gap-1">
    <Label
      name="descriptionSv"
      label={t("admin.attendees.attendee.description-sv")}
    />
    <TextArea name="descriptionSv" value={attendee.descriptionSv} />
  </div>
  <div class="flex flex-col gap-1">
    <Label
      name="descriptionEn"
      label={t("admin.attendees.attendee.description-en")}
    />
    <TextArea name="descriptionEn" value={attendee.descriptionEn} />
  </div>
  <div class="flex flex-col gap-1">
    <Label name="industry" label={t("admin.attendees.attendee.industry")} />
    <TextInput name="industry" value={attendee.industry} />
  </div>
  <div class="flex flex-col gap-1">
    <Label name="tags" label={t("admin.attendees.attendee.tags")} />
    <TextInput name="tags" value={attendee.tags} />
  </div>
  <div class="flex flex-col gap-1">
    <Label name="contact" label={t("admin.attendees.attendee.contact")} />
    <TextInput name="contact" value={attendee.contact} />
  </div>
  <div class="flex flex-col gap-1">
    <Label name="linkedin" label={t("admin.attendees.attendee.linkedin")} />
    <TextInput name="linkedin" value={attendee.linkedin} />
  </div>

  <div class="flex flex-col gap-1">
    <Label name="image" label={t("admin.attendees.attendee.picture")} />

    <Image
      src={attendeeImage}
      alt={t("admin.attendees.attendee.picture")}
      width={128}
      height={128}
      class="h-32 w-32 object-cover rounded-lg"
    />

    <FileInput name="image" />
  </div>

  <div class="flex gap-4 justify-between mt-4">
    <button
      type="submit"
      class="btn bg-pink/50 frosted-glass text-card-content rounded-2xl hover:bg-card/80 hover:scale-[1.01] hover:shadow-black/70 transition-all duration-300 ease-out w-fit px-4 py-2"
    >
      {t("admin.attendees.save")}
    </button>

    {
      !newAttendee && (
        <button
          type="button"
          name="delete"
          value={attendee.id}
          class="btn bg-destructive/50 frosted-glass text-card-content rounded-2xl hover:bg-destructive/80 hover:scale-[1.01] hover:shadow-black/70 transition-all duration-300 ease-out w-fit px-4 py-2"
        >
          {t("admin.attendees.delete")}
        </button>
      )
    }
  </div>
</form>

<script>
  import { actions } from "astro:actions";
  import { navigate } from "astro:transitions/client";

  const deleteButton: HTMLButtonElement | null = document.querySelector(
    "button[name='delete']",
  );
  if (deleteButton) {
    deleteButton.addEventListener("click", async () => {
      if (
        confirm(
          "Are you sure you want to delete this attendee? This action cannot be undone.",
        )
      ) {
        const formData = new FormData();
        formData.append("id", deleteButton.value);

        const { error } = await actions.attendee.deleteAttendee(formData);
        if (error) {
          alert(
            `Failed to delete attendee: ${
              error.message ?? "An unknown error occurred."
            }`,
          );
        } else {
          navigate(`/admin/attendees`);
        }
      }
    });
  }
</script>
