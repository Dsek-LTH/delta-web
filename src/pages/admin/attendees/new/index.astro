---
import Page from "../Page.astro";
import { actions } from "astro:actions";
import { attendeesTable } from "@/db/schema";

let attendee: typeof attendeesTable.$inferSelect = {
  id: 0,
  name: "",
  descriptionSv: "",
  descriptionEn: "",
  industry: "",
  tags: "",
  contact: "",
  linkedin: "",
};

const result = Astro.getActionResult(actions.attendee.addAttendee);

if (result?.data?.id) {
  return Astro.redirect(`/admin/attendees/${result.data.id}`);
}
---

<Page attendee={attendee} newAttendee={true} />
