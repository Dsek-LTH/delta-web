---
import Page from "../Page.astro";
import { actions } from "astro:actions";
import { attendeesTable } from "@/db/schema";
import { withImageWarning } from "@/files/imageWarnings";

let attendee: typeof attendeesTable.$inferSelect = {
  id: 0,
  name: "",
  descriptionSv: "",
  descriptionEn: "",
  industry: "",
  tags: "",
  contact: "",
  linkedin: "",
};

const result = Astro.getActionResult(actions.attendee.addAttendee);

if (result?.data?.id) {
  return Astro.redirect(
    withImageWarning(
      `/admin/attendees/${result.data.id}`,
      result.data.imageWarning,
    ),
  );
}
---

<Page attendee={attendee} newAttendee={true} />
