---
import Layout from "@/layouts/Layout.astro";
import { fileHandler } from "@/files";
import { type FileData } from "@/files/fileHandler";
import { env } from "@/envvars";

let pictures: FileData[] = [];
pictures = env.MINIO_BUCKET_PUBLIC
  ? await fileHandler
      .getInBucket(
        Astro.request.headers,
        env.MINIO_BUCKET_PUBLIC,
        "test/",
        true,
      )
      .catch((err) => {
        console.error("Error fetching files", err);
        return [];
      })
  : [];
---

<Layout title="Test files" description="Test files">
  <div class="flex flex-col justify-start flex-1 w-full gap-8 p-30 px-60">
    <h1 class="text-3xl font-bold">Test files</h1>
    <p class="text-balance">
      This page is for testing file uploads and downloads.
    </p>
  </div>
  {
    pictures.map((picture) => {
      <div class="flex flex-col justify-start flex-1 w-full gap-8 p-30 px-60">
        <h2 class="text-2xl font-bold">{picture.name}</h2>
        <p class="text-balance">Size: {picture.size} bytes</p>
        <p class="text-balance">
          Last modified: {picture.modDate?.toISOString()}
        </p>
        <a
          class="btn btn-primary frosted-glass text-brand-secondary rounded-2xl hover:bg-card/80 hover:scale-[1.01] hover:shadow-black/70 transition-all duration-300 ease-out w-fit px-4 py-2 bg-card/50"
          href={picture.thumbnailUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          Download
        </a>
      </div>;
    })
  }
</Layout>
