---
import Card from "@/components/Card.astro";

interface Props {
  question: string;
}
const { question } = Astro.props;
---

<Card animate={false} class="flex items-center flex-col lg:flex-row h-full">
  <details class="group h-full w-full">
    <summary class="text-xl font-bold p-6 sm:p-8 cursor-pointer">
      {question}
    </summary>
    <div
      class="grid grid-rows-[0fr] group-open:grid-rows-[1fr] transition-[grid-template-rows] duration-300 ease-out"
    >
      <div class="overflow-hidden pb-6 px-6 sm:pb-8 sm:px-8">
        <slot />
      </div>
    </div>
  </details>
</Card>
