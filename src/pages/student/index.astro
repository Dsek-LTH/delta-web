---
import Layout from "@/layouts/Layout.astro";
import { i18n, getRenderedContent } from "@/i18n/utils";
import SessionImg from "@/assets/explaining.webp";
import WhatImg from "@/assets/tekfok/0010.webp";
import WhyImg from "@/assets/tekfok/0012.webp";
import HowImg from "@/assets/tekfok/tekfok26_0001.webp";
import WorkImg from "@/assets/tekfok/0009.webp";
import AfterImg from "@/assets/tekfok/banket.webp";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

// Extra photos shown opposite a card while its "Läs mer" fold is open.
import WhatPhoto2 from "@/assets/tekfok/0004.webp";
import WhatPhoto3 from "@/assets/tekfok/tekfok26_0013.webp";
import WhyPhoto2 from "@/assets/tekfok/0005.webp";
import WhyPhoto3 from "@/assets/tekfok/tekfok26_0015.webp";
import HowPhoto2 from "@/assets/tekfok/tekfok26_0002.webp";
import HowPhoto3 from "@/assets/tekfok/tekfok26_0007.webp";
import WorkPhoto2 from "@/assets/tekfok/tekfok26_0019.webp";
import WorkPhoto3 from "@/assets/tekfok/0008.webp";
import AfterPhoto2 from "@/assets/tekfok/tekfok26_0022.webp";
import AfterPhoto3 from "@/assets/tekfok/tekfok26_0004.webp";
import SessionPhoto2 from "@/assets/tekfok/tekfok26_0021.webp";
import SessionPhoto3 from "@/assets/tekfok/tekfok26_0023.webp";

import InfoCard from "./InfoCard.astro";
import CardContent from "./CardContent.astro";
import Countdown from "@/components/Countdown.astro";
import FaqCard from "./FaqCard.astro";
import { getEntry } from "astro:content";

const { lang, translate: t } = i18n(Astro.cookies);

const studentSession = await getRenderedContent(
  getEntry,
  lang,
  "student/student-sessions",
);
const what = await getRenderedContent(getEntry, lang, "student/what");
const why = await getRenderedContent(getEntry, lang, "student/why");
const how = await getRenderedContent(getEntry, lang, "student/how");
const work = await getRenderedContent(getEntry, lang, "student/work");
const after = await getRenderedContent(getEntry, lang, "student/after");

const faqOrganizersAnswer = await getRenderedContent(
  getEntry,
  lang,
  "student/faq/organizers",
);
const faqWhenAnswer = await getRenderedContent(
  getEntry,
  lang,
  "student/faq/when",
);
const faqWhereAnswer = await getRenderedContent(
  getEntry,
  lang,
  "student/faq/where",
);
const faqContactAnswer = await getRenderedContent(
  getEntry,
  lang,
  "student/faq/contact",
);

const timelineItems: {
  title: string;
  img: ImageMetadata;
  imgAlt: string;
  html: string | null | undefined;
  gallery: [ImageMetadata, ImageMetadata];
}[] = [
  {
    title: t("student.what.title"),
    img: WhatImg,
    imgAlt: t("student.what.imgAlt"),
    html: what?.html,
    gallery: [WhatPhoto2, WhatPhoto3],
  },
  {
    title: t("student.why.title"),
    img: WhyImg,
    imgAlt: t("student.why.imgAlt"),
    html: why?.html,
    gallery: [WhyPhoto2, WhyPhoto3],
  },
  {
    title: t("student.how.title"),
    img: HowImg,
    imgAlt: t("student.how.imgAlt"),
    html: how?.html,
    gallery: [HowPhoto2, HowPhoto3],
  },
  {
    title: t("student.work.title"),
    img: WorkImg,
    imgAlt: t("student.work.imgAlt"),
    html: work?.html,
    gallery: [WorkPhoto2, WorkPhoto3],
  },
  {
    title: t("student.after.title"),
    img: AfterImg,
    imgAlt: t("student.after.imgAlt"),
    html: after?.html,
    gallery: [AfterPhoto2, AfterPhoto3],
  },
  {
    title: t("student.session.title"),
    img: SessionImg,
    imgAlt: t("student.session.imgAlt"),
    html: studentSession?.html,
    gallery: [SessionPhoto2, SessionPhoto3],
  },
];
---

<Layout
  title={t("student.meta.title")}
  description={t("student.meta.description")}
  class="flex flex-col items-center gap-16 px-6 py-16 mx-auto max-w-7xl lg:px-16"
>
  <div class="flex flex-col items-center gap-4 text-center">
    <h1>
      <span
        class="lg:text-7xl text-5xl font-bold tracking-tight text-brand-primary"
      >
        {t("student.title")}
      </span>
    </h1>
    <Countdown class="lg:text-3xl text-2xl" />
  </div>
  <div class="relative w-full" data-timeline>
    <span
      aria-hidden="true"
      class="absolute top-0 bottom-0 left-4 w-px -translate-x-1/2 bg-border lg:left-1/2"
    >
      <span
        data-timeline-rail
        style="--rail-progress: 0"
        class="absolute inset-0 bg-brand-primary/70"></span>
    </span>
    <div class="flex flex-col gap-8 lg:gap-12">
      {
        timelineItems.map((item, index) => {
          const reversed = index % 2 === 1;
          return (
            <div
              class="relative lg:grid lg:grid-cols-2 lg:gap-16"
              data-timeline-row
            >
              <span
                aria-hidden="true"
                class="absolute left-4 top-1/2 grid size-8 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full frosted-glass font-display text-brand-primary lg:left-1/2"
              >
                Δ
              </span>
              <div
                class:list={[
                  "reveal pl-12 lg:pl-0",
                  reversed ? "lg:col-start-2" : "lg:col-start-1",
                ]}
              >
                <InfoCard
                  title={item.title}
                  imgSrc={item.img}
                  imgAlt={item.imgAlt}
                  reverse={reversed}
                >
                  <CardContent html={item.html} />
                </InfoCard>
              </div>
              <div
                aria-hidden="true"
                data-row-gallery
                data-from={reversed ? "right" : "left"}
                class:list={[
                  "pointer-events-none relative hidden lg:row-start-1 lg:block",
                  reversed ? "lg:col-start-1" : "lg:col-start-2",
                ]}
              >
                <div class="absolute inset-0">
                  <div class="sticky top-24 flex flex-col gap-5">
                    <Image
                      src={item.gallery[0]}
                      alt=""
                      width={800}
                      height={600}
                      class="w-[72%] aspect-4/3 rounded-2xl object-cover"
                    />
                    <Image
                      src={item.gallery[1]}
                      alt=""
                      width={600}
                      height={600}
                      class="ms-auto w-[48%] aspect-square rounded-2xl object-cover"
                    />
                  </div>
                </div>
              </div>
            </div>
          );
        })
      }
    </div>

    <div class="reveal w-full max-w-3xl">
      <h2
        class="lg:text-5xl text-3xl font-bold tracking-tight text-brand-primary"
      >
        {t("student.faq.title")}
      </h2>
      <div class="flex flex-col gap-4 mt-4">
        <FaqCard question={t("student.faq.organizers.question")}>
          {
            faqOrganizersAnswer && (
              <div class="space-y-3" set:html={faqOrganizersAnswer.html} />
            )
          }
        </FaqCard>
        <FaqCard question={t("student.faq.when.question")}>
          {
            faqWhenAnswer && (
              <div class="space-y-3" set:html={faqWhenAnswer.html} />
            )
          }
        </FaqCard>
        <FaqCard question={t("student.faq.where.question")}>
          {
            faqWhereAnswer && (
              <div class="space-y-3" set:html={faqWhereAnswer.html} />
            )
          }
        </FaqCard>
        <FaqCard question={t("student.faq.contact.question")}>
          {
            faqContactAnswer && (
              <div class="space-y-3" set:html={faqContactAnswer.html} />
            )
          }
        </FaqCard>
      </div>
    </div>
  </div>
</Layout>
