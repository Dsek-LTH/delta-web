---
import Layout from "@/layouts/Layout.astro";
import Card from "@/components/Card.astro";
import Logo from "@/components/Logo.astro";
import Countdown from "@/components/Countdown.astro";
import { i18n } from "@/i18n/utils";
const { lang, translate: t } = await i18n(Astro.cookies);
---

<Layout
  title={t("404.title")}
  description={t("404.description")}
  class="flex flex-col items-center gap-12 px-6 py-12 mx-auto w-full max-w-7xl lg:px-16"
>
  <div class="text-center text-shadow-md/25">
    <h1 aria-label="DELTA" role="img" class="contents">
      <Logo class="lg:text-9xl text-7xl" animate />
    </h1>
    <Countdown class="lg:text-4xl text-2xl" />
  </div>

  <div class="w-1/3">
    <Card
      class="w-fit lg:h-110 lg:max-w-full max-w-1/4 p-8 lg:order-2 order-1 flex flex-col gap-6 text-center"
    >
      <h2
        class="text-5xl font-bold tracking-tight text-brand-primary text-shadow-sm/25 dark:text-shadow-none"
      >
        {t("404.title")}
      </h2>
      <p>
        {t("404.message")}
        <a
          class="text-backdrop-content-highlight hover:text-backdrop-content-highlight/80"
          href="mailto:it@delta.desk.se"
        >
          it@delta.dsek.se
        </a>.
      </p>

      <p>
        <a
          href="/"
          class="text-backdrop-content-highlight hover:text-backdrop-content-highlight/80"
          >{t("404.return")}</a
        >
      </p>
    </Card>
  </div>
</Layout>
