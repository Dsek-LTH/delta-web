---
import { twMerge } from "tailwind-merge";

const {
  value,
  name,
  class: className,
  ...rest
} = Astro.props as {
  value: string;
  name: string;
  class: string;
};
---

<input
  class={twMerge(
    "w-full rounded-lg p-2 bg-card/5 frosted-glass hover:bg-card/80 frosted-glass  transition-all duration-300 ease-out",
    className,
  )}
  {...rest}
  type="text"
  name={name}
  id={name}
  value={value}
/>
