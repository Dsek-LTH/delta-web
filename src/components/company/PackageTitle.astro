---
import { twMerge } from "tailwind-merge";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"h2"> {
  title: string;
}

const { title, class: className, ...rest } = Astro.props;
---

<h2
  class={twMerge("text-center text-4xl font-extrabold text-bronze", className)}
  {...rest}
>
  {title}
</h2>
