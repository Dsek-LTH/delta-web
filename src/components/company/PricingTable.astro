---
import { Check, X } from "@lucide/astro";
import { twMerge } from "tailwind-merge";
import { i18n } from "@/i18n/utils";

const { translate: t } = i18n(Astro);

const tierOrder = [
  {
    id: "nonprofit",
    name: t("company.pricing.tier.nonprofit"),
    price: t("company.pricing.price.nonprofit"),
    color: "text-diamond",
    border: "border-diamond",
    bar: "bg-diamond",
    glow: "shadow-[0_0_15px_3px] shadow-diamond/80",
  },
  {
    id: "startup",
    name: t("company.pricing.tier.startup"),
    price: t("company.pricing.price.startup"),
    color: "text-bronze",
    border: "border-bronze",
    bar: "bg-bronze",
    glow: "shadow-[0_0_15px_3px] shadow-bronze/80",
  },
  {
    id: "delta",
    name: t("company.pricing.tier.delta"),
    price: t("company.pricing.price.delta"),
    color: "text-gold",
    border: "border-gold",
    bar: "bg-gold",
    glow: "shadow-[0_0_15px_3px] shadow-gold/80",
  },
  {
    id: "deltaPlusPlus",
    name: t("company.pricing.tier.deltaPlusPlus"),
    price: t("company.pricing.price.deltaPlusPlus"),
    color: "text-silver",
    border: "border-silver",
    bar: "bg-silver",
    glow: "shadow-[0_0_15px_3px] shadow-silver/80",
  },
  {
    id: "deltaSharp",
    name: t("company.pricing.tier.deltaSharp"),
    price: t("company.pricing.price.deltaSharp"),
    color: "text-amethyst",
    border: "border-amethyst",
    bar: "bg-amethyst",
    glow: "shadow-[0_0_15px_3px] shadow-amethyst/80",
  },
] as const;

const pricingRows = [
  {
    label: t("company.pricing.row.booth"),
    values: {
      delta: t("company.pricing.value.standardBooth"),
      deltaPlusPlus: t("company.pricing.value.standardBooth"),
      deltaSharp: t("company.pricing.value.standardBooth"),
      nonprofit: t("company.pricing.value.standardBooth"),
      startup: t("company.pricing.value.standardBooth"),
    },
  },
  {
    label: t("company.pricing.row.boothPlacement"),
    values: {
      delta: false,
      deltaPlusPlus: t("company.pricing.value.centralBooth"),
      deltaSharp: t("company.pricing.value.chooseBooth"),
      nonprofit: false,
      startup: false,
    },
  },
  {
    label: t("company.pricing.row.table"),
    values: {
      delta: "1",
      deltaPlusPlus: "1",
      deltaSharp: "1",
      nonprofit: "1",
      startup: "1",
    },
  },
  {
    label: t("company.pricing.row.chair"),
    values: {
      delta: 2,
      deltaPlusPlus: 2,
      deltaSharp: 2,
      nonprofit: 1,
      startup: 1,
    },
  },
  {
    label: t("company.pricing.row.wifi"),
    values: {
      delta: true,
      deltaPlusPlus: true,
      deltaSharp: true,
      nonprofit: true,
      startup: true,
    },
  },
  {
    label: t("company.pricing.row.storageDelivery"),
    values: {
      delta: true,
      deltaPlusPlus: true,
      deltaSharp: true,
      nonprofit: false,
      startup: false,
    },
  },
  {
    label: t("company.pricing.row.lunch"),
    values: {
      delta: true,
      deltaPlusPlus: true,
      deltaSharp: true,
      nonprofit: false,
      startup: false,
    },
  },
  {
    label: t("company.pricing.row.afterParty"),
    values: {
      delta: true,
      deltaPlusPlus: true,
      deltaSharp: true,
      nonprofit: true,
      startup: true,
    },
  },
  {
    label: t("company.pricing.row.lounge"),
    values: {
      delta: true,
      deltaPlusPlus: true,
      deltaSharp: true,
      nonprofit: true,
      startup: true,
    },
  },
  {
    label: t("company.pricing.row.breakfast"),
    values: {
      delta: true,
      deltaPlusPlus: true,
      deltaSharp: true,
      nonprofit: false,
      startup: false,
    },
  },
  {
    label: t("company.pricing.row.parking"),
    values: {
      delta: 2,
      deltaPlusPlus: 2,
      deltaSharp: 2,
      nonprofit: false,
      startup: false,
    },
  },
  {
    label: t("company.pricing.row.representative"),
    values: {
      delta: true,
      deltaPlusPlus: true,
      deltaSharp: true,
      nonprofit: false,
      startup: false,
    },
  },
  {
    label: t("company.pricing.row.wardrobeInfodesk"),
    values: {
      delta: true,
      deltaPlusPlus: true,
      deltaSharp: true,
      nonprofit: true,
      startup: true,
    },
  },
  {
    label: t("company.pricing.row.logo"),
    values: {
      delta: true,
      deltaPlusPlus: true,
      deltaSharp: true,
      nonprofit: true,
      startup: true,
    },
  },
  {
    label: t("company.pricing.row.caseEvening"),
    values: {
      delta: false,
      deltaPlusPlus: true,
      deltaSharp: false,
      nonprofit: false,
      startup: false,
    },
  },
  {
    label: t("company.pricing.row.studentSessions"),
    values: {
      delta: false,
      deltaPlusPlus: true,
      deltaSharp: false,
      nonprofit: false,
      startup: false,
    },
  },
  {
    label: t("company.pricing.row.lunchLecture"),
    values: {
      delta: false,
      deltaPlusPlus: false,
      deltaSharp: true,
      nonprofit: false,
      startup: false,
    },
  },
];
---

<section class="w-full flex flex-col gap-6">
  <div class="flex flex-col items-center gap-4 text-center">
    <h2
      class="text-5xl font-bold uppercase tracking-tight text-center text-brand-primary text-shadow-sm/25 dark:text-shadow-none"
    >
      {t("company.pricing.compareTitle")}
    </h2>
    <p class="max-w-3xl leading-relaxed text-card-content">
      {t("company.pricing.compareSubtitle")}
    </p>
  </div>

  <div class="hidden lg:block overflow-x-auto rounded-2xl frosted-glass">
    <table class="w-full min-w-200 border-collapse">
      <thead>
        <tr>
          <th
            scope="col"
            class="px-6 py-6 text-left text-xl font-bold uppercase tracking-tight min-w-56"
          >
            {t("company.pricing.feature")}
          </th>
          {
            tierOrder.map((tier) => (
              <th
                scope="col"
                class={twMerge(
                  "relative px-4 pt-6 pb-6 border-t-4 text-center min-w-44",
                  tier.border,
                )}
              >
                <span
                  aria-hidden="true"
                  class={twMerge(
                    "absolute -top-0.5 inset-x-0 h-1",
                    tier.bar,
                    tier.glow,
                  )}
                />
                <div class="flex flex-col items-center gap-2">
                  <span class={twMerge("text-2xl font-extrabold", tier.color)}>
                    {tier.name}
                  </span>
                  <span class="text-lg font-semibold text-card-content">
                    {tier.price}
                  </span>
                </div>
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody>
        {
          pricingRows.map((row) => (
            <tr class="border-t border-border odd:bg-card-highlight/40">
              <th scope="row" class="px-6 py-4 text-left font-semibold">
                {row.label}
              </th>
              {tierOrder.map((tier) => {
                const value = row.values[tier.id];
                return (
                  <td class="px-4 py-4 text-center min-w-44">
                    {typeof value === "boolean" ? (
                      value ? (
                        <Check
                          aria-label={t("company.pricing.yes")}
                          class={twMerge("size-6 mx-auto", tier.color)}
                        />
                      ) : (
                        <X
                          aria-label={t("company.pricing.no")}
                          class="size-6 mx-auto text-card-content"
                        />
                      )
                    ) : (
                      <span class="text-card-content">{value}</span>
                    )}
                  </td>
                );
              })}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <div class="lg:hidden flex flex-col gap-8">
    {
      tierOrder.map((tier) => (
        <div class="frosted-glass rounded-2xl overflow-hidden">
          <div
            class={twMerge("relative border-t-4 text-center py-6", tier.border)}
          >
            <span
              aria-hidden="true"
              class={twMerge(
                "absolute -top-0.5 inset-x-0 h-1",
                tier.bar,
                tier.glow,
              )}
            />
            <div class="flex flex-col items-center gap-2">
              <span class={twMerge("text-2xl font-extrabold", tier.color)}>
                {tier.name}
              </span>
              <span class="text-lg font-semibold text-card-content-muted">
                {tier.price}
              </span>
            </div>
          </div>
          <ul class="flex flex-col">
            {pricingRows.map((row) => {
              const value = row.values[tier.id];
              return (
                <li class="flex items-center justify-between gap-4 px-4 py-3 border-t border-border odd:bg-card-highlight/40">
                  <span class="font-semibold">{row.label}</span>
                  {typeof value === "boolean" ? (
                    value ? (
                      <Check
                        aria-label={t("company.pricing.yes")}
                        class={twMerge("size-6 shrink-0", tier.color)}
                      />
                    ) : (
                      <X
                        aria-label={t("company.pricing.no")}
                        class="size-6 shrink-0 text-card-content"
                      />
                    )
                  ) : (
                    <span class="text-card-content font-medium">{value}</span>
                  )}
                </li>
              );
            })}
          </ul>
        </div>
      ))
    }
  </div>
</section>
