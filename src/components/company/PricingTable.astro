---
import { Check, X } from "@lucide/astro";
import { twMerge } from "tailwind-merge";
import { i18n } from "@/i18n/utils";

const { translate: t } = i18n(Astro);

const tierOrder = [
  {
    id: "nonprofit",
    name: t("company.pricing.tier.nonprofit"),
    price: t("company.pricing.price.nonprofit"),
    color: "text-diamond",
    border: "border-diamond",
    bar: "bg-diamond",
    glow: "shadow-[0_0_15px_3px] shadow-diamond/80",
  },
  {
    id: "startup",
    name: t("company.pricing.tier.startup"),
    price: t("company.pricing.price.startup"),
    color: "text-bronze",
    border: "border-bronze",
    bar: "bg-bronze",
    glow: "shadow-[0_0_15px_3px] shadow-bronze/80",
  },
  {
    id: "delta",
    name: t("company.pricing.tier.delta"),
    price: t("company.pricing.price.delta"),
    color: "text-gold",
    border: "border-gold",
    bar: "bg-gold",
    glow: "shadow-[0_0_15px_3px] shadow-gold/80",
  },
  {
    id: "deltaPlusPlus",
    name: t("company.pricing.tier.deltaPlusPlus"),
    price: t("company.pricing.price.deltaPlusPlus"),
    color: "text-silver",
    border: "border-silver",
    bar: "bg-silver",
    glow: "shadow-[0_0_15px_3px] shadow-silver/80",
  },
  {
    id: "deltaSharp",
    name: t("company.pricing.tier.deltaSharp"),
    price: t("company.pricing.price.deltaSharp"),
    color: "text-amethyst",
    border: "border-amethyst",
    bar: "bg-amethyst",
    glow: "shadow-[0_0_15px_3px] shadow-amethyst/80",
  },
] as const;

const pricingRows = [
  {
    label: t("company.pricing.row.booth"),
    values: {
      delta: t("company.pricing.value.standardBooth"),
      deltaPlusPlus: t("company.pricing.value.standardBooth"),
      deltaSharp: t("company.pricing.value.standardBooth"),
      nonprofit: t("company.pricing.value.standardBooth"),
      startup: t("company.pricing.value.standardBooth"),
    },
  },
  {
    label: t("company.pricing.row.boothPlacement"),
    values: {
      delta: false,
      deltaPlusPlus: t("company.pricing.value.centralBooth"),
      deltaSharp: t("company.pricing.value.chooseBooth"),
      nonprofit: false,
      startup: false,
    },
  },
  {
    label: t("company.pricing.row.table"),
    values: {
      delta: "1",
      deltaPlusPlus: "1",
      deltaSharp: "1",
      nonprofit: "1",
      startup: "1",
    },
  },
  {
    label: t("company.pricing.row.chair"),
    values: {
      delta: 2,
      deltaPlusPlus: 2,
      deltaSharp: 2,
      nonprofit: 1,
      startup: 1,
    },
  },
  {
    label: t("company.pricing.row.wifi"),
    values: {
      delta: true,
      deltaPlusPlus: true,
      deltaSharp: true,
      nonprofit: true,
      startup: true,
    },
  },
  {
    label: t("company.pricing.row.storageDelivery"),
    values: {
      delta: true,
      deltaPlusPlus: true,
      deltaSharp: true,
      nonprofit: false,
      startup: false,
    },
  },
  {
    label: t("company.pricing.row.lunch"),
    values: {
      delta: true,
      deltaPlusPlus: true,
      deltaSharp: true,
      nonprofit: false,
      startup: false,
    },
  },
  {
    label: t("company.pricing.row.afterParty"),
    values: {
      delta: true,
      deltaPlusPlus: true,
      deltaSharp: true,
      nonprofit: true,
      startup: true,
    },
  },
  {
    label: t("company.pricing.row.lounge"),
    values: {
      delta: true,
      deltaPlusPlus: true,
      deltaSharp: true,
      nonprofit: true,
      startup: true,
    },
  },
  {
    label: t("company.pricing.row.breakfast"),
    values: {
      delta: true,
      deltaPlusPlus: true,
      deltaSharp: true,
      nonprofit: false,
      startup: false,
    },
  },
  {
    label: t("company.pricing.row.parking"),
    values: {
      delta: t("company.pricing.value.perRepresentative"),
      deltaPlusPlus: t("company.pricing.value.perRepresentative"),
      deltaSharp: t("company.pricing.value.perRepresentative"),
      nonprofit: false,
      startup: false,
    },
  },
  {
    label: t("company.pricing.row.representative"),
    values: {
      delta: true,
      deltaPlusPlus: true,
      deltaSharp: true,
      nonprofit: t("company.pricing.value.viaInfodesk"),
      startup: t("company.pricing.value.viaInfodesk"),
    },
  },
  {
    label: t("company.pricing.row.wardrobeInfodesk"),
    values: {
      delta: true,
      deltaPlusPlus: true,
      deltaSharp: true,
      nonprofit: true,
      startup: true,
    },
  },
  {
    label: t("company.pricing.row.logo"),
    values: {
      delta: true,
      deltaPlusPlus: true,
      deltaSharp: true,
      nonprofit: true,
      startup: true,
    },
  },
  {
    label: t("company.pricing.row.caseEvening"),
    values: {
      delta: false,
      deltaPlusPlus: true,
      deltaSharp: false,
      nonprofit: false,
      startup: false,
    },
  },
  {
    label: t("company.pricing.row.studentSessions"),
    values: {
      delta: false,
      deltaPlusPlus: true,
      deltaSharp: false,
      nonprofit: false,
      startup: false,
    },
  },
  {
    label: t("company.pricing.row.lunchLecture"),
    values: {
      delta: false,
      deltaPlusPlus: false,
      deltaSharp: true,
      nonprofit: false,
      startup: false,
    },
  },
];
---

<section class="w-full flex flex-col gap-6">
  <div class="flex flex-col items-center gap-4 text-center">
    <h2
      class="text-5xl font-bold uppercase tracking-tight text-center text-brand-primary text-shadow-sm/25 dark:text-shadow-none"
    >
      {t("company.pricing.compareTitle")}
    </h2>
    <p class="max-w-3xl leading-relaxed text-card-content">
      {t("company.pricing.compareSubtitle")}
    </p>
  </div>

  <div
    class="overflow-x-auto rounded-2xl frosted-glass"
    role="region"
    aria-label={t("company.pricing.compareTitle")}
    tabindex="0"
  >
    <table class="w-full min-w-200 border-collapse">
      <thead>
        <tr>
          <th
            scope="col"
            class="sticky left-0 z-10 min-w-32 bg-backdrop px-4 py-5 text-left text-base font-bold uppercase tracking-tight sm:min-w-56 sm:px-6 sm:py-6 sm:text-xl"
          >
            {t("company.pricing.feature")}
          </th>
          {
            tierOrder.map((tier) => (
              <th
                scope="col"
                class={twMerge(
                  "relative min-w-32 border-t-4 px-3 pt-5 pb-5 text-center sm:min-w-44 sm:px-4 sm:pt-6 sm:pb-6",
                  tier.border,
                )}
              >
                <span
                  aria-hidden="true"
                  class={twMerge(
                    "absolute -top-0.5 inset-x-0 h-1",
                    tier.bar,
                    tier.glow,
                  )}
                />
                <div class="flex flex-col items-center gap-2">
                  <span
                    class={twMerge(
                      "text-xl font-extrabold sm:text-2xl",
                      tier.color,
                    )}
                  >
                    {tier.name}
                  </span>
                  <span class="text-base font-semibold text-card-content sm:text-lg">
                    {tier.price}
                  </span>
                </div>
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody>
        {
          pricingRows.map((row) => (
            <tr class="border-t border-border odd:bg-card-highlight/40">
              <th
                scope="row"
                class="sticky left-0 z-10 bg-backdrop px-4 py-3 text-left text-sm font-semibold sm:px-6 sm:py-4 sm:text-base"
              >
                {row.label}
              </th>
              {tierOrder.map((tier) => {
                const value = row.values[tier.id];
                return (
                  <td class="min-w-32 px-3 py-3 text-center sm:min-w-44 sm:px-4 sm:py-4">
                    {typeof value === "boolean" ? (
                      value ? (
                        <Check
                          aria-label={t("company.pricing.yes")}
                          class={twMerge("size-6 mx-auto", tier.color)}
                        />
                      ) : (
                        <X
                          aria-label={t("company.pricing.no")}
                          class="size-6 mx-auto text-card-content"
                        />
                      )
                    ) : (
                      <span class="text-sm text-card-content sm:text-base">
                        {value}
                      </span>
                    )}
                  </td>
                );
              })}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>
