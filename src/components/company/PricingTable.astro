---
import { Check, X } from "@lucide/astro";
import { twMerge } from "tailwind-merge";
import { i18n } from "@/i18n/utils";

const { translate: t } = i18n(Astro.cookies);

const tierOrder = [
  {
    id: "nonprofit",
    name: t("company.pricing.tier.nonprofit"),
    price: t("company.pricing.price.nonprofit"),
    color: "text-diamond",
    border: "border-diamond",
    bar: "bg-diamond",
    glow: "shadow-[0_0_15px_3px] shadow-diamond/80",
  },
  {
    id: "startup",
    name: t("company.pricing.tier.startup"),
    price: t("company.pricing.price.startup"),
    color: "text-bronze",
    border: "border-bronze",
    bar: "bg-bronze",
    glow: "shadow-[0_0_15px_3px] shadow-bronze/80",
  },
  {
    id: "standard",
    name: t("company.pricing.tier.standard"),
    price: t("company.pricing.price.standard"),
    color: "text-gold",
    border: "border-gold",
    bar: "bg-gold",
    glow: "shadow-[0_0_15px_3px] shadow-gold/80",
  },
  {
    id: "plus",
    name: t("company.pricing.tier.plus"),
    price: t("company.pricing.price.plus"),
    color: "text-silver",
    border: "border-silver",
    bar: "bg-silver",
    glow: "shadow-[0_0_15px_3px] shadow-silver/80",
  },
  {
    id: "hash",
    name: t("company.pricing.tier.hash"),
    price: t("company.pricing.price.hash"),
    color: "text-amethyst",
    border: "border-amethyst",
    bar: "bg-amethyst",
    glow: "shadow-[0_0_15px_3px] shadow-amethyst/80",
  },
  {
    id: "main",
    name: t("company.pricing.tier.main"),
    price: t("company.pricing.price.main"),
    color: "text-emerald",
    border: "border-emerald",
    bar: "bg-emerald",
    glow: "shadow-[0_0_15px_3px] shadow-emerald/80",
  },
] as const;

const pricingRows = [
  {
    label: t("company.pricing.row.booth"),
    values: {
      nonprofit: t("company.pricing.value.standardBooth"),
      startup: t("company.pricing.value.standardBooth"),
      standard: t("company.pricing.value.standardBooth"),
      plus: t("company.pricing.value.standardBooth"),
      hash: t("company.pricing.value.standardBooth"),
      main: t("company.pricing.value.standardBooth"),
    },
  },
  {
    label: t("company.pricing.row.placement"),
    values: {
      nonprofit: t("company.pricing.value.notGuaranteed"),
      startup: t("company.pricing.value.notGuaranteed"),
      standard: false,
      plus: t("company.pricing.value.central"),
      hash: t("company.pricing.value.choose"),
      main: t("company.pricing.value.first"),
    },
  },
  {
    label: t("company.pricing.row.table"),
    values: {
      nonprofit: t("company.pricing.value.oneStool"),
      startup: t("company.pricing.value.oneStool"),
      standard: t("company.pricing.value.twoStools"),
      plus: t("company.pricing.value.twoStools"),
      hash: t("company.pricing.value.twoStools"),
      main: t("company.pricing.value.twoStools"),
    },
  },
  {
    label: t("company.pricing.row.afterEvent"),
    values: {
      nonprofit: true,
      startup: true,
      standard: true,
      plus: true,
      hash: true,
      main: true,
    },
  },
  {
    label: t("company.pricing.row.meals"),
    values: {
      nonprofit: false,
      startup: false,
      standard: true,
      plus: true,
      hash: true,
      main: true,
    },
  },
  {
    label: t("company.pricing.row.parking"),
    values: {
      nonprofit: false,
      startup: false,
      standard: true,
      plus: true,
      hash: true,
      main: true,
    },
  },
  {
    label: t("company.pricing.row.lounge"),
    values: {
      nonprofit: t("company.pricing.value.coffee"),
      startup: t("company.pricing.value.coffee"),
      standard: t("company.pricing.value.breakfast"),
      plus: t("company.pricing.value.breakfast"),
      hash: t("company.pricing.value.breakfast"),
      main: t("company.pricing.value.breakfast"),
    },
  },
  {
    label: t("company.pricing.row.wardrobe"),
    values: {
      nonprofit: true,
      startup: true,
      standard: true,
      plus: true,
      hash: true,
      main: true,
    },
  },
  {
    label: t("company.pricing.row.host"),
    values: {
      nonprofit: false,
      startup: false,
      standard: true,
      plus: true,
      hash: true,
      main: true,
    },
  },
  {
    label: t("company.pricing.row.wifi"),
    values: {
      nonprofit: true,
      startup: true,
      standard: true,
      plus: true,
      hash: true,
      main: true,
    },
  },
  {
    label: t("company.pricing.row.caseEvening"),
    values: {
      nonprofit: false,
      startup: false,
      standard: false,
      plus: true,
      hash: false,
      main: false,
    },
  },
  {
    label: t("company.pricing.row.studentSessions"),
    values: {
      nonprofit: false,
      startup: false,
      standard: false,
      plus: true,
      hash: false,
      main: true,
    },
  },
  {
    label: t("company.pricing.row.lunchLecture"),
    values: {
      nonprofit: false,
      startup: false,
      standard: false,
      plus: false,
      hash: true,
      main: true,
    },
  },
  {
    label: t("company.pricing.row.tv"),
    values: {
      nonprofit: false,
      startup: false,
      standard: false,
      plus: false,
      hash: false,
      main: true,
    },
  },
  {
    label: t("company.pricing.row.flag"),
    values: {
      nonprofit: false,
      startup: false,
      standard: false,
      plus: false,
      hash: false,
      main: true,
    },
  },
  {
    label: t("company.pricing.row.foodTickets"),
    values: {
      nonprofit: false,
      startup: false,
      standard: false,
      plus: false,
      hash: false,
      main: 100,
    },
  },
  {
    label: t("company.pricing.row.drinkTickets"),
    values: {
      nonprofit: false,
      startup: false,
      standard: false,
      plus: false,
      hash: false,
      main: 200,
    },
  },
  {
    label: t("company.pricing.row.marketing"),
    values: {
      nonprofit: false,
      startup: false,
      standard: false,
      plus: false,
      hash: false,
      main: true,
    },
  },
  {
    label: t("company.pricing.row.priority"),
    values: {
      nonprofit: false,
      startup: false,
      standard: false,
      plus: false,
      hash: false,
      main: true,
    },
  },
];
---

<div class="w-full flex flex-col gap-6">
  <div class="hidden lg:block overflow-x-auto rounded-2xl frosted-glass">
    <table class="w-full min-w-200 border-collapse">
      <thead>
        <tr>
          <th
            scope="col"
            class="px-6 py-6 text-left text-xl font-bold uppercase tracking-tight min-w-56"
          >
            {t("company.pricing.feature")}
          </th>
          {
            tierOrder.map((tier) => (
              <th
                scope="col"
                class={twMerge(
                  "relative px-4 pt-6 pb-6 border-t-4 text-center min-w-44",
                  tier.border,
                )}
              >
                <span
                  aria-hidden="true"
                  class={twMerge(
                    "absolute -top-0.5 inset-x-0 h-1",
                    tier.bar,
                    tier.glow,
                  )}
                />
                <div class="flex flex-col items-center gap-2">
                  <span class={twMerge("text-2xl font-extrabold", tier.color)}>
                    {tier.name}
                  </span>
                  <span class="font-mono text-lg font-semibold tabular-nums text-card-content">
                    {tier.price}
                  </span>
                </div>
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody>
        {
          pricingRows.map((row) => (
            <tr class="border-t border-border odd:bg-card-highlight/40">
              <th scope="row" class="px-6 py-4 text-left font-semibold">
                {row.label}
              </th>
              {tierOrder.map((tier) => {
                const value = row.values[tier.id];
                return (
                  <td class="px-4 py-4 text-center min-w-44">
                    {typeof value === "boolean" ? (
                      value ? (
                        <Check
                          aria-label={t("company.pricing.yes")}
                          class={twMerge("size-6 mx-auto", tier.color)}
                        />
                      ) : (
                        <X
                          aria-label={t("company.pricing.no")}
                          class="size-6 mx-auto text-card-content"
                        />
                      )
                    ) : (
                      <span class="text-card-content">{value}</span>
                    )}
                  </td>
                );
              })}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <div class="lg:hidden flex flex-col gap-8">
    {
      tierOrder.map((tier) => (
        <div class="frosted-glass rounded-2xl overflow-hidden">
          <div
            class={twMerge("relative border-t-4 text-center py-6", tier.border)}
          >
            <span
              aria-hidden="true"
              class={twMerge(
                "absolute -top-0.5 inset-x-0 h-1",
                tier.bar,
                tier.glow,
              )}
            />
            <div class="flex flex-col items-center gap-2">
              <span class={twMerge("text-2xl font-extrabold", tier.color)}>
                {tier.name}
              </span>
              <span class="font-mono text-lg font-semibold tabular-nums text-card-content-muted">
                {tier.price}
              </span>
            </div>
          </div>
          <ul class="flex flex-col">
            {pricingRows.map((row) => {
              const value = row.values[tier.id];
              return (
                <li class="flex items-center justify-between gap-4 px-4 py-3 border-t border-border odd:bg-card-highlight/40">
                  <span class="font-semibold">{row.label}</span>
                  {typeof value === "boolean" ? (
                    value ? (
                      <Check
                        aria-label={t("company.pricing.yes")}
                        class={twMerge("size-6 shrink-0", tier.color)}
                      />
                    ) : (
                      <X
                        aria-label={t("company.pricing.no")}
                        class="size-6 shrink-0 text-card-content"
                      />
                    )
                  ) : (
                    <span class="text-card-content font-medium">{value}</span>
                  )}
                </li>
              );
            })}
          </ul>
        </div>
      ))
    }
  </div>
</div>
