---
import { i18n } from "@/i18n/utils";
import ContactList from "./ContactList.astro";

import { deltaForceTable } from "@/db/schema";
import { sqliteTable, text } from "drizzle-orm/sqlite-core";
import { eq } from "drizzle-orm";
import { createSelectSchema } from "drizzle-orm/zod";
import { db } from "@/db/connect";
import { bySortOrder } from "@/constants";

const { translate: t } = i18n(Astro);

const contacts = sqliteTable("contacts", {
  firstName: text().notNull(),
  lastName: text().notNull(),
  email: text().notNull(),
  linkedin: text().notNull(),
});

const contactSelectSchema = createSelectSchema(contacts);

const itManagers = (
  await db
    .select()
    .from(deltaForceTable)
    .where(eq(deltaForceTable.role, "it"))
    .all()
).sort(bySortOrder);

const itManagersValidated = itManagers.map((manager) =>
  contactSelectSchema.parse(manager),
);

const generals = (
  await db
    .select()
    .from(deltaForceTable)
    .where(eq(deltaForceTable.role, "general"))
    .all()
).sort(bySortOrder);

const generalsValidated = generals.map((general) =>
  contactSelectSchema.parse(general),
);
---

<footer
  class="relative p-4 pb-12 leading-relaxed flex flex-col items-center gap-4 text-center"
>
  <address class="not-italic">
    <p class="text-xl font-semibold pb-2 text-backdrop-content">
      {t("footer.contact")}
      : <a
        class="text-backdrop-content-highlight hover:text-backdrop-content-highlight/80"
        href="mailto:delta@dsek.se">delta@dsek.se</a
      >
    </p>
    <div class="grid grid-cols-2 gap-5 border-y border-border py-3">
      <ContactList
        title={t("footer.generals")}
        groupMail="general@delta.dsek.se"
        contacts={generalsValidated}
      />
      <ContactList
        title={t("footer.it-managers")}
        groupMail="it@delta.dsek.se"
        contacts={itManagersValidated}
      />
    </div>
  </address>

  <p class="text-backdrop-content">&copy; 2026 DELTA. All rights reserved.</p>

  <p class="text-xl font-semibold italic text-backdrop-content">
    {t("footer.development")}
    <a
      class="text-backdrop-content-highlight hover:text-backdrop-content-highlight/80"
      href="https://github.com/Dsek-LTH/delta-web"
    >
      GitHub
    </a>.
  </p>

  <a
    class="inline-flex items-center gap-2 rounded-sm text-backdrop-content-highlight transition-colors outline-none hover:text-backdrop-content-highlight/80 focus-visible:ring-2 focus-visible:ring-backdrop-content-highlight/60"
    href="https://www.linkedin.com/company/delta.dsek"
    target="_blank"
    rel="noopener noreferrer"
  >
    <svg
      viewBox="0 0 24 24"
      class="size-5 shrink-0"
      fill="currentColor"
      aria-hidden="true"
    >
      <path
        d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
      ></path>
    </svg>
    {t("footer.linkedin")}
  </a>

  <a
    class="absolute bottom-0 text-sm text-backdrop-content-muted opacity-0 transition-opacity duration-200 hover:opacity-100 focus-visible:opacity-100 hover:text-backdrop-content-highlight/80"
    href={`/admin`}>{t("footer.admin-panel")}</a
  >

  <span
    aria-hidden="true"
    class="footer-mark pointer-events-none select-none font-display"
  >
    &Delta;
  </span>
</footer>
