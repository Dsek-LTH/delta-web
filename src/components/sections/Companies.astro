import PricingTable from "@/components/company/PricingTable.astro";
import { i18n } from "@/i18n/utils";
import CompanyImage from "@/assets/tekfok/tekfok26_0015.webp";

const { translate: t } = i18n(Astro);
/* ------------------------------------------------------------------ *
