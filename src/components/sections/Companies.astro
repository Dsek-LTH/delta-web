// Card layout: the two entry packages are small; the three DELTΔ packages
// share a row.
const entryTiers = tiers.slice(0, 2);
const deltaTiers = tiers.slice(2, 5);
---

<!-- För företag -->
<section
  id="foretag"
  data-nav-section="foretag"
  class="flex w-full max-w-7xl flex-col items-center gap-16 border-t border-border/60 px-6 py-24 lg:gap-20 lg:px-16"
>
  <div class="grid w-full items-center gap-8 lg:grid-cols-[1.5fr_1fr] lg:gap-0">
    <div
      class="frosted-glass rounded-2xl px-8 py-10 reveal lg:py-12 lg:pr-32 lg:pl-12"
    >
      <h2 class="text-3xl font-bold text-card-content lg:text-4xl">
        <Logo animate />
        <span class="ms-[0.5em] italic">{t("company.hero.forCompanies")}</span>
      </h2>

      <p class="mt-8 max-w-xl leading-relaxed text-card-content">
        {t("company.intro.attend")}
      </p>

      <p class="mt-4 max-w-md text-sm leading-relaxed text-card-content-muted">
        {t("company.intro.combine")}{" "}
        <a
          href="mailto:delta@dsek.se"
          class="text-backdrop-content-highlight transition-colors hover:text-backdrop-content-highlight/80"
          >delta@dsek.se</a
        >
      </p>

      <a
        href="mailto:delta@dsek.se"
        class="btn btn-accent mt-8 rounded-full px-6 py-3 text-lg"
      >
        {t("company.package.contact")}
      </a>

      <p class="mt-6 max-w-md text-xs leading-relaxed text-card-content-muted">
        {t("company.intro.websiteBefore")}{" "}
        <a
          href="https://www.dsek.se/info/for-foretag"
          target="_blank"
          rel="noopener noreferrer"
          class="text-backdrop-content-highlight transition-colors hover:text-backdrop-content-highlight/80"
          >{t("company.intro.websiteLink")}</a
        >{t("company.intro.websiteAfter")}
      </p>
    </div>
    <Image
      src={CompanyImage}
      alt={t("landing.gallery.alt.talk")}
      width={800}
      height={1000}
      class="z-10 h-64 w-full rounded-2xl object-cover shadow-xl ring-1 ring-border lg:-ml-24 lg:h-80 lg:w-[calc(100%+6rem)]"
    />
  </div>

  <div id="pricing" class="flex w-full flex-col gap-10">
    <div class="flex flex-col items-center gap-4 text-center reveal">
      <h3
        class="text-5xl font-bold uppercase tracking-tight text-center text-brand-primary"
      >
        {t("company.pricing.title")}
      </h3>
      <p class="max-w-3xl leading-relaxed text-card-content">
        {t("company.pricing.subtitle")}
      </p>
    </div>

    <div class="grid w-full gap-6 reveal sm:grid-cols-2 lg:grid-cols-3">
      {
        deltaTiers.map((tier) => (
          <Package
            class={`border-0 border-t-4 p-6 shadow-lg ${tier.accent} ${tier.glow}`}
          >
            <PackageTitle title={tier.name} class={`text-3xl ${tier.color}`} />
            <div class="flex flex-col gap-1">
              <p class="text-center font-mono text-2xl font-bold tabular-nums text-card-content">
                {tier.price}
              </p>
              {tier.discount && (
                <p class="text-center font-mono text-xs text-card-content-muted">
                  {tier.discount}
                </p>
              )}
            </div>
            <p class="text-center text-sm leading-relaxed text-card-content-muted">
              {tier.intro}
            </p>
            <ul class="mt-2 flex flex-col gap-2.5 text-sm text-card-content">
              {tier.highlights.map((highlight) => (
                <li class="flex items-start gap-2">
                  <Check class={`mt-0.5 size-4 shrink-0 ${tier.color}`} />
                  <span>{highlight}</span>
                </li>
              ))}
            </ul>
            <div class="mt-auto flex flex-col items-center gap-3">
              <button
                type="button"
                data-tier-details={tier.id}
                aria-expanded="false"
                aria-controls={`tier-details-${tier.id}`}
                class="group flex items-center gap-1 text-sm font-semibold text-brand-primary transition-colors hover:text-brand-primary/80"
              >
                {t("company.package.showDetails")}
                <ChevronDown class="size-4 transition-transform duration-300 group-aria-expanded:rotate-180" />
              </button>
              <a
                href="mailto:delta@dsek.se"
                class={`rounded-full px-5 ${tier.cta}`}
              >
                {t("company.package.contact")}
              </a>
            </div>
          </Package>
        ))
      }
    </div>

    <div data-tier-panel-host hidden class="fold-wrap w-full">
      <div class="fold-panel">
        {deltaTiers.map((tier) => <PackageDetails tier={tier} />)}
      </div>
    </div>

    <div class="grid w-full gap-6 sm:grid-cols-2 reveal">
      {
        entryTiers.map((tier) => (
          <Package
            class={`border-0 border-t-4 p-5 shadow-md ${tier.accent} ${tier.glow}`}
          >
            <div class="flex items-baseline justify-between gap-4">
              <PackageTitle
                title={tier.name}
                class={`text-left text-2xl ${tier.color}`}
              />
              <p class="font-mono text-lg font-semibold tabular-nums text-card-content">
                {tier.price}
              </p>
            </div>
            <p class="line-clamp-3 text-sm leading-relaxed text-card-content-muted">
              {tier.intro}
            </p>
            <div class="mt-auto flex items-center justify-between gap-3">
              <button
                type="button"
                data-tier-details={tier.id}
                aria-expanded="false"
                aria-controls={`tier-details-${tier.id}`}
                class="group flex items-center gap-1 text-sm font-semibold text-brand-primary transition-colors hover:text-brand-primary/80"
              >
                {t("company.package.showDetails")}
                <ChevronDown class="size-4 transition-transform duration-300 group-aria-expanded:rotate-180" />
              </button>
              <a
                href="mailto:delta@dsek.se"
                class={`rounded-full px-4 py-1.5 text-sm ${tier.cta}`}
              >
                {t("company.package.contact")}
              </a>
            </div>
          </Package>
        ))
      }
    </div>

    <div data-tier-panel-host hidden class="fold-wrap w-full">
      <div class="fold-panel">
        {entryTiers.map((tier) => <PackageDetails tier={tier} />)}
      </div>
    </div>

    <PricingTable />
  </div>
</section>

<script>
  const detailButtons = document.querySelectorAll<HTMLButtonElement>(
    "[data-tier-details]",
  );
  const hosts = document.querySelectorAll<HTMLElement>(
    "[data-tier-panel-host]",
  );
  const panels = document.querySelectorAll<HTMLElement>("[data-tier-panel]");

  const setActive = (activeId: string | undefined) => {
    panels.forEach((panel) => {
      panel.inert = panel.dataset.tierPanel !== activeId;
    });
    detailButtons.forEach((button) => {
      button.setAttribute(
        "aria-expanded",
        String(button.dataset.tierDetails === activeId),
      );
    });
  };

  const closeHost = (host: HTMLElement) => {
    host.removeAttribute("data-open");
    window.setTimeout(() => {
      if (!host.hasAttribute("data-open")) host.hidden = true;
    }, 350);
  };

  const closePanels = () => {
    hosts.forEach(closeHost);
    setActive(undefined);
  };

  const openPanel = (tierId: string) => {
    const target = [...panels].find(
      (panel) => panel.dataset.tierPanel === tierId,
    );
    const host = target?.closest<HTMLElement>("[data-tier-panel-host]");
    if (!target || !host) return;

    // Only one group's panel is open at a time; others close instantly.
    hosts.forEach((other) => {
      if (other !== host) {
        other.removeAttribute("data-open");
        other.hidden = true;
      }
    });

    panels.forEach((panel) => {
      panel.hidden = panel !== target;
    });
    setActive(tierId);

    host.hidden = false;
    if (!host.hasAttribute("data-open")) {
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          host.setAttribute("data-open", "");
        });
      });
    }

    window.setTimeout(() => {
      if (host.hasAttribute("data-open")) {
        target.scrollIntoView({ behavior: "smooth", block: "nearest" });
      }
    }, 340);
  };

  detailButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const id = button.dataset.tierDetails;
      const target = [...panels].find(
        (panel) => panel.dataset.tierPanel === id,
      );
      const host = target?.closest<HTMLElement>("[data-tier-panel-host]");
      const isOpen =
        !!host &&
        host.hasAttribute("data-open") &&
        !host.hidden &&
        !!target &&
        !target.hidden;

      if (isOpen) {
        closePanels();
      } else {
        openPanel(id ?? "");
      }
    });
  });

  document
    .querySelectorAll<HTMLButtonElement>("[data-tier-close]")
    .forEach((button) => {
      button.addEventListener("click", closePanels);
    });
</script>
