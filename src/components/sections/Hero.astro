---
import { Image } from "astro:assets";
import { CalendarPlus, MapPin, Users } from "@lucide/astro";

import Card from "@/components/Card.astro";
import Countdown from "@/components/Countdown.astro";
import Logo from "@/components/Logo.astro";
import { i18n, getRenderedContent } from "@/i18n/utils";
import { fairDate } from "@/constants";
import { getEntry } from "astro:content";

import GalleryFormula from "@/assets/tekfok/0000.webp";
import GalleryHall from "@/assets/tekfok/tekfok26_0011.webp";
import GalleryTalk from "@/assets/tekfok/tekfok26_0014.webp";
import GalleryGroup from "@/assets/tekfok/tekfok26_0018.webp";

const { lang, translate: t } = i18n(Astro);

/* ------------------------------------------------------------------ *
 * Hero — the top of the one-page scroll
 * ------------------------------------------------------------------ */

const whatIs = await getRenderedContent(getEntry, lang, "landing-what-is");

const pad = (value: number) => String(value).padStart(2, "0");
const toCalendarDate = (date: Date) =>
  `${date.getFullYear()}${pad(date.getMonth() + 1)}${pad(date.getDate())}T${pad(date.getHours())}${pad(date.getMinutes())}00`;

const fairEnd = new Date(fairDate);
fairEnd.setHours(17, 0, 0, 0);

const calendarUrl =
  "https://calendar.google.com/calendar/render?action=TEMPLATE" +
  "&text=DELTA%202027" +
  `&dates=${toCalendarDate(fairDate)}/${toCalendarDate(fairEnd)}` +
  "&ctz=Europe%2FStockholm" +
  `&location=${encodeURIComponent("E-Huset, LTH, Ole Römers väg 3, 223 63 Lund")}`;
---

<!-- Hero — the top of the one-page scroll -->
<section
  id="top"
  class="mx-auto flex w-full max-w-7xl flex-col items-center gap-16 px-6 pb-24 lg:gap-20 lg:px-16"
>
  <div
    class="grid w-full content-center items-center gap-14 min-h-[calc(100dvh-6.5rem)] lg:min-h-[calc(100dvh-5rem)] lg:grid-cols-[1.25fr_0.75fr]"
  >
    <div class="flex flex-col items-start gap-6 text-left animate-rise">
      <span class="font-mono text-sm text-card-content-muted">
        {
          fairDate.toLocaleDateString(lang, {
            day: "numeric",
            month: "long",
            year: "numeric",
          })
        } · E-Huset, LTH
      </span>
      <h1
        aria-label="DELTA"
        role="img"
        class="contents text-7xl leading-none lg:text-9xl"
      >
        <Logo animate />
      </h1>
      <p
        class="font-mono text-base text-card-content-muted lg:text-lg"
        aria-live="off"
      >
        <span class="sr-only">{t("landing.typing.1")}</span>
        <span aria-hidden="true">
          <span
            data-typing
            data-lines={JSON.stringify([
              t("landing.typing.1"),
              t("landing.typing.2"),
              t("landing.typing.3"),
            ])}></span>
          <span
            class="ml-1 inline-block h-[1em] w-[0.5ch] animate-caret-blink bg-brand-primary align-middle"
          ></span>
        </span>
      </p>
      <p class="max-w-xl text-lg text-balance text-card-content-muted">
        {t("landing.head.description")}
      </p>
      <div class="flex flex-wrap items-center gap-3">
        <a
          href="#foretag"
          class="group btn btn-accent relative overflow-hidden rounded-full px-6 py-3 text-lg hover:-translate-y-0.5 hover:-rotate-1 hover:scale-[1.03] active:rotate-0"
        >
          <span class="relative z-10 flex items-center gap-2">
            {t("landing.cta.packages")}
            <span
              aria-hidden="true"
              class="inline-block transition-transform duration-200 group-hover:translate-x-1"
            >
              →
            </span>
          </span>
          <span
            aria-hidden="true"
            class="pointer-events-none absolute inset-0 -translate-x-full bg-gradient-to-r from-transparent via-white/25 to-transparent transition-transform duration-500 group-hover:translate-x-full"
          ></span>
        </a>
        <a
          href="#studenter"
          class="group btn btn-ghost relative overflow-hidden rounded-full px-6 py-3 text-lg hover:-translate-y-0.5 hover:rotate-1 hover:scale-[1.03] active:rotate-0"
        >
          <span class="relative z-10 flex items-center gap-2">
            <span
              aria-hidden="true"
              class="inline-block text-brand-primary group-hover:animate-bounce"
            >
              Δ
            </span>
            <span>{t("student.title")}</span>
          </span>
          <span
            aria-hidden="true"
            class="pointer-events-none absolute inset-0 -translate-x-full bg-gradient-to-r from-transparent via-brand-primary/10 to-transparent transition-transform duration-500 group-hover:translate-x-full"
          ></span>
        </a>
      </div>
    </div>

    <!-- Right: photo stack -->
    <div
      class="relative mx-auto w-full max-w-md pb-12 animate-rise [animation-delay:120ms]"
    >
      <Image
        src={GalleryFormula}
        alt={t("landing.gallery.alt.formula")}
        width={600}
        height={450}
        class="w-[78%] -rotate-3 rounded-2xl border border-border object-cover shadow-lg"
      />
      <Image
        src={GalleryGroup}
        alt={t("landing.gallery.alt.group")}
        width={600}
        height={450}
        class="absolute -bottom-4 right-0 w-[60%] rotate-2 rounded-2xl border border-border object-cover shadow-lg"
      />
      <div
        class="frosted-glass absolute bottom-2 left-0 rounded-full px-5 py-2"
      >
        <Countdown class="text-xl lg:text-2xl" />
      </div>
    </div>
  </div>

  <div
    class="grid gap-8 w-full max-w-110 lg:grid-cols-3 lg:items-end lg:max-w-full"
  >
    <Card
      class="p-8 lg:order-1 order-2 flex flex-col gap-6 animate-rise [animation-delay:60ms] lg:h-108"
    >
      <h2
        class="text-5xl font-bold uppercase tracking-tight text-center text-brand-primary"
      >
        {t("landing.card.where")}
      </h2>
      <div class="flex flex-col flex-1 gap-4">
        <div class="flex flex-col items-center gap-1 text-center">
          <p class="text-xl font-semibold">E-Huset, LTH</p>
          <p class="flex items-center gap-2 text-sm text-card-content-muted">
            <MapPin class="size-4 shrink-0" />
            <span>
              Ole Römers väg 3, 223 63 Lund, {t("landing.card.where.sweden")}
            </span>
          </p>
        </div>
        <iframe
          class="w-full flex-1 min-h-50 rounded-xl border-0"
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d1001.2498072316307!2d13.209636197891264!3d55.711069045083036!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x465397ca158a6165%3A0x7f9339d3824e88ee!2sOle%20R%C3%B6mers%20v%C3%A4g%203%2C%20223%2063%20Lund!5e0!3m2!1ssv!2sse!4v1665410976182!5m2!1ssv!2sse"
          title={t("landing.card.where.map.title")}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        >
          E-huset LTH Ole Römers väg 3.
        </iframe>
      </div>
    </Card>

    <Card
      class="p-8 lg:order-2 order-1 flex flex-col justify-between gap-6 animate-rise [animation-delay:120ms] lg:h-120"
    >
      <h2
        class="text-5xl font-bold uppercase tracking-tight text-center text-brand-primary"
      >
        {t("landing.card.when")}
      </h2>
      <div class="flex flex-col gap-4 text-center">
        <p
          class="text-3xl font-bold leading-tight text-balance first-letter:uppercase lg:text-4xl"
        >
          {
            fairDate.toLocaleDateString(lang, {
              weekday: "long",
              year: "numeric",
              month: "long",
              day: "numeric",
            })
          }
        </p>
        <p class="text-xl text-card-content-muted lg:text-2xl">08:00–17:00</p>
      </div>
      <div class="flex flex-col items-center gap-4">
        <p
          class="flex items-center justify-center gap-2 text-base text-card-content-muted"
        >
          <Users class="size-5 shrink-0" />
          <span>{t("landing.card.when.networking")}</span>
        </p>
        <a
          href={calendarUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-ghost rounded-full px-4 py-2 text-sm"
        >
          <CalendarPlus class="size-4" />
          {t("landing.card.when.calendar")}
        </a>
      </div>
    </Card>

    <Card
      class="p-8 order-3 flex flex-col gap-6 animate-rise [animation-delay:180ms] lg:h-108"
    >
      <h2
        class="text-5xl font-bold uppercase tracking-tight text-center text-brand-primary"
      >
        {t("landing.card.what")}
      </h2>
      <div
        class="flex flex-col flex-1 gap-4 overflow-y-auto pr-1 leading-relaxed prose"
      >
        {whatIs && <div set:html={whatIs.html} />}
      </div>
      <div
        class="pointer-events-none absolute inset-x-0 bottom-0 h-10 rounded-b-2xl bg-gradient-to-t from-card to-transparent"
      >
      </div>
    </Card>
  </div>

  <div class="grid w-full grid-cols-2 gap-3 reveal sm:grid-cols-4 sm:gap-4">
    <Image
      src={GalleryFormula}
      alt={t("landing.gallery.alt.formula")}
      width={600}
      height={450}
      class="aspect-[4/3] w-full rounded-2xl object-cover"
    />
    <Image
      src={GalleryHall}
      alt={t("landing.gallery.alt.hall")}
      width={600}
      height={450}
      class="aspect-[4/3] w-full rounded-2xl object-cover"
    />
    <Image
      src={GalleryTalk}
      alt={t("landing.gallery.alt.talk")}
      width={600}
      height={450}
      class="aspect-[4/3] w-full rounded-2xl object-cover"
    />
    <Image
      src={GalleryGroup}
      alt={t("landing.gallery.alt.group")}
      width={600}
      height={450}
      class="aspect-[4/3] w-full rounded-2xl object-cover"
    />
  </div>
</section>

<script>
  // Typed hero line: types each phrase, pauses, deletes and moves on.
  const typingTarget = document.querySelector<HTMLElement>("[data-typing]");
  if (typingTarget) {
    const lines: string[] = JSON.parse(typingTarget.dataset.lines ?? "[]");
    const reducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    if (reducedMotion || lines.length === 0) {
      typingTarget.textContent = lines[0] ?? "";
    } else {
      let line = 0;
      let pos = 0;
      let deleting = false;
      const tick = () => {
        const current = lines[line]!;
        pos += deleting ? -1 : 1;
        typingTarget.textContent = current.slice(0, pos);

        let delay = deleting ? 22 : 45 + Math.random() * 40;
        if (!deleting && pos === current.length) {
          deleting = true;
          delay = 2600;
        } else if (deleting && pos === 0) {
          deleting = false;
          line = (line + 1) % lines.length;
          delay = 400;
        }
        window.setTimeout(tick, delay);
      };
      window.setTimeout(tick, 1400);
    }
  }
</script>
