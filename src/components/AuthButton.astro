---
import { i18n } from "@/i18n/utils";
const { translate: t } = i18n(Astro);
import { twMerge } from "tailwind-merge";

const {
  class: className,
  callbackURL,
  ...rest
} = Astro.props as {
  class: string;
  callbackURL?: string;
};

const loggedIn = Astro.locals.session;
---

<button
  id={loggedIn ? "logout-btn" : "login-btn"}
  data-callback-url={callbackURL}
  class={twMerge("btn btn-ghost", className)}
  {...rest}
>
  {t(loggedIn ? "authButton.logout" : "authButton.login")}
</button>

<script>
  import { authClient } from "@/auth/auth-client";

  const loginButton = document.getElementById("login-btn");
  if (loginButton) {
    loginButton.addEventListener("click", async () => {
      try {
        await authClient.signIn.social({
          provider: "authentik",
          callbackURL: loginButton.dataset.callbackUrl || window.location.href,
        });
      } catch (err) {
        console.error("Error starting oauth2 sign-in:", err);
      }
    });
  }

  const logoutButton = document.getElementById("logout-btn");
  if (logoutButton) {
    logoutButton.addEventListener("click", async () => {
      try {
        await authClient.signOut();
      } catch (err) {
        console.error("Error starting oauth2 sign-out:", err);
      }
      window.location.reload();
    });
  }
</script>
