---
import { i18n } from "@/i18n/utils";
const { lang, translate: t } = await i18n(Astro.cookies);
import { twMerge } from "tailwind-merge";

const { class: className, ...rest } = Astro.props as {
  class: string;
};

const loggedIn = Astro.locals.session;
---

<button
  id={loggedIn ? "logout-btn" : "login-btn"}
  class={twMerge("btn btn-ghost", className)}
  {...rest}
>
  {t(loggedIn ? "authButton.logout" : "authButton.login")}
</button>

<script>
  import { authClient } from "@/auth/auth-client";

  document.getElementById("login-btn")?.addEventListener("click", async () => {
    try {
      const response = await authClient.signIn.oauth2({
        providerId: "authentik",
        callbackURL: window.location.href,
      });
    } catch (err) {
      console.error("Error starting oauth2 sign-in:", err);
    }
  });

  document.getElementById("logout-btn")?.addEventListener("click", async () => {
    try {
      const response = await authClient.signOut();
    } catch (err) {
      console.error("Error starting oauth2 sign-out:", err);
    }
    window.location.reload();
  });
</script>
