---
import { twMerge } from "tailwind-merge";

type DropdownEntry = {
  description: string;
  value: any;
};

const {
  class: className,
  entries,
  selectedEntry,
  ...rest
} = Astro.props as {
  class: string;
  entries: Array<DropdownEntry>;
  selectedEntry: DropdownEntry;
};

// Unique per render so multiple instances of this component on one page
// don't collide on the same id -- computed server-side, not client JS.
---

<select class={twMerge("field", className)} {...rest}>
  {
    entries.map((entry) => (
      <option
        value={entry.value}
        selected={entry.value === selectedEntry.value}
        aria-label={entry.description}
      >
        {entry.description}
      </option>
    ))
  }
</select>
