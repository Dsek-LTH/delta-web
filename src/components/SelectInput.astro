---
import { getLang, getLocalizedPath } from "@/i18n/utils";
import { ChevronDown } from "@lucide/astro";

type DropdownEntry = {
  description: string;
  value: any;
};

const {
  class: className,
  entries,
  selectedEntry,
  ...rest
} = Astro.props as {
  class: string;
  entries: Array<DropdownEntry>;
  selectedEntry: DropdownEntry;
};

// Unique per render so multiple instances of this component on one page
// don't collide on the same id -- computed server-side, not client JS.
---

<select
  class:list={[
    "w-full rounded-lg p-2 bg-card/5 frosted-glass hover:bg-card/80 frosted-glass  transition-all duration-300 ease-out",
    className,
  ]}
  {...rest}
>
  {
    entries.map((entry) => (
      <option
        value={entry.value}
        selected={entry.value === selectedEntry.value}
        aria-label={entry.description}
      >
        {entry.description}
      </option>
    ))
  }
</select>
