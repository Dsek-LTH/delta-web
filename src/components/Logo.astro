---
import type { HTMLAttributes } from "astro/types";
import { twMerge } from "tailwind-merge";

interface Props extends HTMLAttributes<"span"> {
  animate?: boolean;
}

const { animate = false, class: className, ...rest } = Astro.props;
const animation = animate ? "animate-caret-blink" : "";
---

<span
  class={twMerge("font-bold font-noto-sans text-brand-primary", className)}
  {...rest}
>
  &gt;&nbsp;<span class="text-brand-secondary">DELT</span>&Delta;<span
    class={animation}>&#95;</span
  >
</span>
