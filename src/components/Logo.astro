---
import type { HTMLAttributes } from "astro/types";
import { twMerge } from "tailwind-merge";

interface Props extends HTMLAttributes<"span"> {
  animate?: boolean;
  /** Use light text for the wordmark on dark/photo backgrounds. */
  inverse?: boolean;
}

const {
  animate = false,
  inverse = false,
  class: className,
  ...rest
} = Astro.props;
const animation = animate ? "animate-caret-blink" : "";
---

<span
  class={twMerge("font-bold font-display text-brand-primary", className)}
  {...rest}
>
  &gt;&nbsp;<span class={inverse ? "text-white" : "text-card-content"}
    >DELT</span
  >&Delta;<span class={animation}>&#95;</span>
</span>
