---
const { class: className, enableScrollFade = false, ...rest } = Astro.props;
---

<div
  class:list={[
    "tilt-card relative overflow-hidden frosted-glass flex flex-col min-h-0 min-w-0 w-full h-full rounded-2xl transition-[transform] duration-300 ease-out transform-3d",
    className,
  ]}
  {...rest}
>
  <div
    class="shimmer-layer -z-10 pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-500 ease-out bg-[radial-gradient(circle_at_var(--x,50%)_var(--y,50%),var(--color-card-shimmer),transparent_60%)]"
  >
  </div>

  <div
    class:list={[
      {
        "h-full w-full overflow-y-auto pr-4 pb-4 custom-scrollbar scroll-fade-target":
          enableScrollFade,
      },
    ]}
  >
    <slot />
  </div>
</div>
<!-- Fade at the bottom of the text when it overflows the card -->
<style>
  .scroll-fade-target {
    -webkit-mask-image: linear-gradient(
      to bottom,
      black calc(100% - 3rem),
      transparent 100%
    );
    mask-image: linear-gradient(
      to bottom,
      black calc(100% - 3rem),
      transparent 100%
    );
  }

  .scroll-fade-target.is-at-bottom {
    -webkit-mask-image: none;
    mask-image: none;
  }
</style>

<!-- Make scrollbar disappear when not hovered or used -->
<style>
  .custom-scrollbar::-webkit-scrollbar {
    width: 6px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }

  .custom-scrollbar::-webkit-scrollbar-thumb {
    background-color: transparent;
    border-radius: 9999px;
  }

  .custom-scrollbar[data-scrolling="true"]::-webkit-scrollbar-thumb,
  .tilt-card:hover .custom-scrollbar::-webkit-scrollbar-thumb {
    background-color: var(--color-card-highlight);
  }

  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background-color: var(--color-backdrop) !important;
  }
</style>

<script>
  const scrollContainers = document.querySelectorAll(".scroll-fade-target");

  scrollContainers.forEach((container) => {
    let timer: ReturnType<typeof setTimeout>;

    container.addEventListener("scroll", () => {
      container.setAttribute("data-scrolling", "true");

      clearTimeout(timer);

      timer = setTimeout(() => {
        container.removeAttribute("data-scrolling");
      }, 1000); // Hide 1 second after scrolling stops
    });
  });
</script>

<!-- Removes the text fade when user has scrolled to the bottom of text -->
<script>
  const scrollBoxes = document.querySelectorAll(".scroll-fade-target");

  scrollBoxes.forEach((scrollBox) => {
    const checkScroll = () => {
      const isBottom =
        scrollBox.scrollHeight - scrollBox.scrollTop - scrollBox.clientHeight <=
        2;

      if (isBottom) {
        scrollBox.classList.add("is-at-bottom");
      } else {
        scrollBox.classList.remove("is-at-bottom");
      }
    };

    scrollBox.addEventListener("scroll", checkScroll);
    checkScroll();
  });
</script>

<script>
  const cards = document.querySelectorAll(".tilt-card");

  cards.forEach((card) => {
    const htmlCard = card as HTMLElement;
    const shimmer = htmlCard.querySelector(".shimmer-layer") as HTMLElement;

    // Tracking variables
    let mouseX = 0;
    let mouseY = 0;
    let currentX = 0;
    let currentY = 0;

    // Smoothing factor (0.01 to 0.1). Lower = more lag.
    const lerpFactor = 0.03;

    const animate = () => {
      // Linear interpolation formula
      currentX += (mouseX - currentX) * lerpFactor;
      currentY += (mouseY - currentY) * lerpFactor;

      shimmer.style.setProperty("--x", `${currentX}px`);
      shimmer.style.setProperty("--y", `${currentY}px`);
      requestAnimationFrame(animate);
    };

    requestAnimationFrame(animate);

    htmlCard.addEventListener("mousemove", (e) => {
      const { left, top } = htmlCard.getBoundingClientRect();
      const x = (e.clientX - left) / htmlCard.offsetWidth - 0.5;
      const y = (e.clientY - top) / htmlCard.offsetHeight - 0.5;

      // Card Tilt
      htmlCard.style.transform = `perspective(1000px) rotateX(${y * -10}deg) rotateY(${x * 10}deg) scale(1.01)`;

      // Update targets for lerp
      mouseX = e.clientX - left;
      mouseY = e.clientY - top;
      shimmer.style.opacity = "1";
    });

    htmlCard.addEventListener("mouseleave", () => {
      htmlCard.style.transform =
        "perspective(1000px) rotateX(0deg) rotateY(0deg) scale(1)";
      shimmer.style.opacity = "0";
    });
  });
</script>
