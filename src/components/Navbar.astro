---
import "@/styles/global.css";
import { i18n } from "@/i18n/utils";
import { twMerge } from "tailwind-merge";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"nav"> {}

const { class: className, ...rest } = Astro.props;

const { translate: t } = i18n(Astro);
const toggleId = `navbar-menu-${Math.random().toString(36).slice(2, 9)}`;
const currentPageLabel = {
  "/project-group": t("navbar.project-group"),
  "/student": t("navbar.student"),
  "/company": t("navbar.company"),
  "/attendees": t("navbar.attendees"),
}[Astro.url.pathname];
// One-page navigation: every item is an anchor into the landing page scroll.
const navItems = [
  { href: "/#besokare", label: t("navbar.attendees"), section: "besokare" },
  { href: "/#foretag", label: t("navbar.company"), section: "foretag" },
  { href: "/#top", label: t("navbar.home"), section: "top" },
  { href: "/#studenter", label: t("navbar.student"), section: "studenter" },
  {
    href: "/#projektgrupp",
    label: t("navbar.project-group"),
    section: "projektgrupp",
  },
];
---

<nav class={twMerge("w-fit", className)} {...rest}>
  <div
    class="lg:hidden group mobile-navbar flex flex-col rounded-2xl frosted-glass p-2 select-none w-fit max-w-[calc(100vw-0.5rem)]"
  >
    <input
      type="checkbox"
      id={toggleId}
      class="sr-only"
      aria-label={t("navbar.menu")}
    />
    <label
      for={toggleId}
      aria-label={t("navbar.menu")}
      class="flex items-center gap-2.5 min-h-9 px-2 cursor-pointer text-card-content hover:text-brand-primary transition-colors"
    >
      <span aria-hidden="true" class="relative block size-6 shrink-0">
        <span
          class="absolute left-0 top-0 h-0.5 w-6 rounded-full bg-current transition-transform duration-300 ease-out group-has-checked:translate-y-[11px] group-has-checked:rotate-45"
        ></span>
        <span
          class="absolute left-0 top-1/2 h-0.5 w-6 -translate-y-1/2 rounded-full bg-current transition-opacity duration-300 ease-out group-has-checked:opacity-0"
        ></span>
        <span
          class="absolute bottom-0 left-0 h-0.5 w-6 rounded-full bg-current transition-transform duration-300 ease-out group-has-checked:-translate-y-[11px] group-has-checked:-rotate-45"
        ></span>
      </span>
      {
        currentPageLabel && (
          <span class="text-lg font-bold text-nowrap">{currentPageLabel}</span>
        )
      }
    </label>
    <div
      class="grid grid-rows-[0fr] grid-cols-[0fr] group-has-checked:grid-rows-[1fr] group-has-checked:grid-cols-[1fr] transition-[grid-template-rows,grid-template-columns] duration-300 ease-out"
    >
      <ul
        class="min-w-0 overflow-hidden flex flex-col gap-1 pt-1 text-lg font-bold text-nowrap"
      >
        {
          navItems.map(({ href, label, section }) => (
            <li>
              <a
                href={href}
                data-nav-section-link={section ?? undefined}
                class="block text-card-content hover:text-brand-primary p-2 data-[active]:text-shadow-glow"
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <ul
    class="hidden lg:grid frosted-glass rounded-full grid-flow-col auto-cols-[1fr_1fr_2.5em_1fr_1fr] text-xl lg:text-2xl font-bold overflow-hidden text-center items-center h-12 lg:h-16 text-nowrap"
  >
    <li>
      <a
        href="/#besokare"
        data-nav-section-link="besokare"
        class={twMerge(
          "text-card-content hover:text-brand-primary p-3 data-[active]:text-shadow-glow",
          Astro.url.pathname === "/attendees" && "text-shadow-glow",
        )}>{t("navbar.attendees")}</a
      >
    </li>
    <li>
      <a
        href="/#foretag"
        data-nav-section-link="foretag"
        class={twMerge(
          "text-card-content hover:text-brand-primary p-3 data-[active]:text-shadow-glow",
          Astro.url.pathname === "/company" && "text-shadow-glow",
        )}>{t("navbar.company")}</a
      >
    </li>
    <li>
      <a
        href="/#top"
        aria-label={t("navbar.home")}
        data-nav-section-link="top"
        class="h-12 lg:h-16 flex justify-center items-center text-4xl leading-none text-brand-primary hover:bg-card-highlight rounded-full aspect-square frosted-glass data-[active]:text-shadow-glow-pink"
        >&Delta;</a
      >
    </li>
    <li>
      <a
        href="/#studenter"
        data-nav-section-link="studenter"
        class={twMerge(
          "text-card-content hover:text-brand-primary p-3 data-[active]:text-shadow-glow",
          Astro.url.pathname === "/student" && "text-shadow-glow",
        )}
      >
        {t("navbar.student")}
      </a>
    </li>
    <li>
      <a
        href="/#projektgrupp"
        data-nav-section-link="projektgrupp"
        class={twMerge(
          "text-card-content hover:text-brand-primary p-3 data-[active]:text-shadow-glow",
          Astro.url.pathname === "/project-group" && "text-shadow-glow",
        )}
      >
        {t("navbar.project-group")}
      </a>
    </li>
  </ul>
</nav>

<script>
  // One-page navigation: the Δ lights up at the top, otherwise the last
  // section whose start has passed the upper half of the viewport.
  const sectionLinks = document.querySelectorAll<HTMLElement>(
    "[data-nav-section-link]",
  );
  const sections = document.querySelectorAll<HTMLElement>("[data-nav-section]");

  if (sectionLinks.length > 0 && sections.length > 0) {
    const updateActive = () => {
      const marker = window.scrollY + window.innerHeight * 0.45;
      let current = sections[0]?.id;
      for (const section of sections) {
        const top = section.getBoundingClientRect().top + window.scrollY;
        if (top <= marker) current = section.id;
      }
      sectionLinks.forEach((link) => {
        link.toggleAttribute(
          "data-active",
          link.dataset.navSectionLink === current,
        );
      });
    };

    let ticking = false;
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(() => {
          ticking = false;
          updateActive();
        });
      }
    };

    updateActive();
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);
  }

  // Close the mobile menu once a link is followed.
  const mobileMenuToggle = document.querySelector<HTMLInputElement>(
    ".mobile-navbar input[type='checkbox']",
  );
  sectionLinks.forEach((link) => {
    link.addEventListener("click", () => {
      if (mobileMenuToggle) mobileMenuToggle.checked = false;
    });
  });
</script>
