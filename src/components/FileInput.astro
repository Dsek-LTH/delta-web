---
import { twMerge } from "tailwind-merge";

const {
  name,
  class: className,
  ...rest
} = Astro.props as {
  value: string;
  name: string;
  class: string;
};
---

<input
  class={twMerge(
    "file-input file-input-bordered file-input-primary w-full rounded-lg p-2 bg-card/5 frosted-glass hover:bg-card/80 transition-all duration-300 ease-out",
    className,
  )}
  {...rest}
  type="file"
  name={name}
  id={name}
/>
