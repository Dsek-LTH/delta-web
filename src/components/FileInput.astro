---
import { twMerge } from "tailwind-merge";

const {
  name,
  class: className,
  ...rest
} = Astro.props as {
  name: string;
  class: string | undefined;
};
---

<input
  class={twMerge(
    "field cursor-pointer text-sm file:mr-4 file:cursor-pointer file:rounded-full file:border-0 file:bg-card-highlight file:px-4 file:py-1.5 file:font-semibold file:text-card-content",
    className,
  )}
  {...rest}
  type="file"
  name={name}
  id={name}
  accept="image/*"
/>
