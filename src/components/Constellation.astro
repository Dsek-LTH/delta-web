---
// Ambient constellation: small dots drifting behind the page. The pointer
// lights nearby dots, links them into a graph, and scales their own velocity
// with proximity (up to ~1.9x) — no attraction, so nothing can be captured
// or clustered. Decorational only: aria-hidden, pointer-events-none; renders
// a static frame under prefers-reduced-motion.
// Debug: add ?paths to any URL for green velocity vectors + the pointer's
// influence radius.
---

<canvas
  data-constellation
  aria-hidden="true"
  class="pointer-events-none fixed inset-0 -z-10"></canvas>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>(
    "[data-constellation]",
  );
  const context = canvas?.getContext("2d");

  if (canvas && context) {
    const reducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    const showDebug = new URLSearchParams(window.location.search).has("paths");

    const LIT_RADIUS = 180; // how far the pointer reaches for lighting
    const LINK_DISTANCE = 140; // dot-to-dot edge length
    const BASE_ALPHA = 0.14; // far from the pointer
    const LIT_ALPHA = 0.6;
    const BASE_RADIUS = 1.2;
    const PARALLAX = 0.1; // field lags the page scroll (distant layer)
    const WRAP_MARGIN = 24;
    const BOOST_RADIUS = 220; // pointer reach for the speed-up
    const SPEED_BOOST = 0.9; // up to ~1.9x near the pointer

    type Point = { x: number; y: number; vx: number; vy: number };

    let width = 0;
    let height = 0;
    let points: Point[] = [];
    let pointerX = -1e4;
    let pointerY = -1e4;
    let pointerActive = false;
    let scrollOffset = 0;
    let scrollTarget = 0;
    let dotColor = "#0f172a";
    let litColor = "#c9457a";

    const readColors = () => {
      const styles = getComputedStyle(document.documentElement);
      dotColor =
        styles.getPropertyValue("--color-backdrop-content").trim() || dotColor;
      litColor =
        styles.getPropertyValue("--color-brand-primary").trim() || litColor;
    };

    // Vertical position of a dot on screen: base position minus the eased
    // scroll parallax, wrapped so the field stays dense while scrolling.
    const wrapY = (y: number) => {
      const range = height + WRAP_MARGIN * 2;
      return ((((y - scrollOffset) % range) + range) % range) - WRAP_MARGIN;
    };

    const resize = () => {
      width = window.innerWidth;
      height = window.innerHeight;
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      context.setTransform(dpr, 0, 0, dpr, 0, 0);

      const count = Math.max(
        32,
        Math.min(120, Math.round((width * height) / 11000)),
      );
      points = Array.from({ length: count }, () => ({
        x: Math.random() * width,
        y: Math.random() * height,
        vx: (Math.random() - 0.5) * 0.36,
        vy: (Math.random() - 0.5) * 0.36,
      }));
    };

    const draw = () => {
      context.clearRect(0, 0, width, height);

      scrollOffset += (scrollTarget - scrollOffset) * 0.09;

      // Move every dot: the pointer only scales its own velocity with
      // proximity (straight paths, no attraction, nothing can be captured).
      const xs: number[] = [];
      const renderYs: number[] = [];
      for (const point of points) {
        xs.push(point.x);
        const renderY = wrapY(point.y);
        renderYs.push(renderY);

        const distance = Math.hypot(pointerX - point.x, pointerY - renderY);
        const speedScale =
          pointerActive && distance < BOOST_RADIUS
            ? 1 + SPEED_BOOST * (1 - distance / BOOST_RADIUS)
            : 1;

        point.x += point.vx * speedScale;
        point.y += point.vy * speedScale;
        if (point.x < 0 || point.x > width) point.vx *= -1;
        if (point.y < 0 || point.y > height) point.vy *= -1;
      }

      if (showDebug) {
        context.globalAlpha = 1;
        context.lineWidth = 1;
        context.strokeStyle = "rgba(0, 200, 90, 0.5)";
        context.beginPath();
        for (let i = 0; i < points.length; i += 1) {
          const point = points[i]!;
          context.moveTo(xs[i]!, renderYs[i]!);
          context.lineTo(xs[i]! + point.vx * 90, renderYs[i]! + point.vy * 90);
        }
        context.stroke();
        if (pointerActive) {
          context.strokeStyle = "rgba(0, 200, 90, 0.25)";
          context.setLineDash([4, 6]);
          context.beginPath();
          context.arc(pointerX, pointerY, BOOST_RADIUS, 0, Math.PI * 2);
          context.stroke();
          context.setLineDash([]);
        }
      }

      const lit = points.map((_, i) => {
        const distance = Math.hypot(xs[i]! - pointerX, renderYs[i]! - pointerY);
        return Math.max(0, 1 - distance / LIT_RADIUS);
      });

      // Edges between lit dots: the graph follows the pointer.
      context.lineWidth = 1;
      context.strokeStyle = litColor;
      for (let i = 0; i < points.length; i += 1) {
        if (lit[i] <= 0) continue;
        for (let j = i + 1; j < points.length; j += 1) {
          if (lit[j] <= 0) continue;
          const dx = xs[i]! - xs[j]!;
          const dy = renderYs[i]! - renderYs[j]!;
          const distance = Math.hypot(dx, dy);
          if (distance > LINK_DISTANCE) continue;
          context.globalAlpha =
            Math.min(lit[i]!, lit[j]!) * (1 - distance / LINK_DISTANCE) * 0.4;
          context.beginPath();
          context.moveTo(xs[i]!, renderYs[i]!);
          context.lineTo(xs[j]!, renderYs[j]!);
          context.stroke();
        }
      }

      // Dots: faint far away, brighter and pink near the pointer.
      for (let i = 0; i < points.length; i += 1) {
        const glow = lit[i]!;
        context.globalAlpha = BASE_ALPHA + glow * (LIT_ALPHA - BASE_ALPHA);
        context.fillStyle = glow > 0 ? litColor : dotColor;
        context.beginPath();
        context.arc(
          xs[i]!,
          renderYs[i]!,
          BASE_RADIUS + glow * 0.9,
          0,
          Math.PI * 2,
        );
        context.fill();
      }
      context.globalAlpha = 1;

      if (!reducedMotion) {
        requestAnimationFrame(draw);
      }
    };

    readColors();
    resize();
    draw();

    new MutationObserver(readColors).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["data-theme"],
    });

    if (!reducedMotion) {
      const onPointerMove = (event: PointerEvent) => {
        pointerX = event.clientX;
        pointerY = event.clientY;
        pointerActive = true;
      };
      const onPointerLeave = () => {
        pointerActive = false;
        pointerX = -1e4;
        pointerY = -1e4;
      };
      const onScroll = () => {
        scrollTarget = window.scrollY * PARALLAX;
      };
      window.addEventListener("pointermove", onPointerMove, { passive: true });
      document.addEventListener("pointerleave", onPointerLeave);
      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", resize);
      onScroll();
      scrollOffset = scrollTarget;
    }
  }
</script>
