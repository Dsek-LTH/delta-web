---
import { twMerge } from "tailwind-merge";

const {
  value,
  name,
  rows = 4,
  class: className,
  ...rest
} = Astro.props as {
  value: string;
  name: string;
  rows?: number;
  class: string;
};
---

<textarea
  class={twMerge(
    "w-full rounded-lg p-2 bg-card/5 frosted-glass hover:bg-card/80 transition-all duration-300 ease-out",
    className,
  )}
  {...rest}
  rows={rows}
  name={name}
  id={name}>{value}</textarea
>
