---
import Navbar from "@/components/Navbar.astro";
import LanguagePicker from "@/components/LanguagePicker.astro";
import ThemePicker from "@/components/ThemePicker.astro";
---

<header class="h-20">
  <div
    class="flex justify-between lg:grid lg:grid-cols-[1fr_auto_1fr] fixed top-2 w-dvw z-1337 px-1 lg:px-4 [view-transition-name:site-header]"
  >
    <div class="flex justify-center lg:col-start-2">
      <Navbar />
    </div>
    <div class="flex gap-2 justify-end items-start lg:col-start-3">
      <ThemePicker />
      <LanguagePicker />
    </div>
  </div>
</header>

<div
  data-scroll-progress
  aria-hidden="true"
  class="pointer-events-none fixed inset-x-0 top-0 z-[1400] h-0.5 bg-brand-primary/70 opacity-0 transition-opacity duration-300"
>
</div>

<script>
  // Scroll progress hairline: direct, rAF-throttled position feedback.
  const progress = document.querySelector<HTMLElement>(
    "[data-scroll-progress]",
  );
  if (progress) {
    let ticking = false;
    const update = () => {
      ticking = false;
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const value = max > 0 ? Math.min(1, window.scrollY / max) : 0;
      progress.style.transform = `scaleX(${value})`;
      progress.style.opacity = window.scrollY > 32 ? "1" : "0";
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    update();
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);
  }
</script>
