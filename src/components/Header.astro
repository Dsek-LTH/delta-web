---
import Navbar from "@/components/Navbar.astro";
import LanguagePicker from "@/components/LanguagePicker.astro";
import ThemePicker from "@/components/ThemePicker.astro";
---

<header class="h-20">
  <div
    class="flex justify-between lg:grid lg:grid-cols-[1fr_auto_1fr] fixed top-2 w-dvw z-1337 px-1 lg:px-4 [view-transition-name:site-header]"
  >
    <div class="flex justify-center lg:col-start-2">
      <Navbar />
    </div>
    <div class="flex gap-2 justify-end items-start lg:col-start-3">
      <ThemePicker />
      <LanguagePicker />
    </div>
  </div>
</header>
