---
import Navbar from "@/components/Navbar.astro";
import LanguagePicker from "@/components/LanguagePicker.astro";
import ThemePicker from "@/components/ThemePicker.astro";
---

<header class="h-20">
  <div
    class="flex justify-between lg:grid lg:grid-cols-3 fixed top-2 w-dvw z-1337 px-4"
  >
    <Navbar class="flex justify-center lg:col-start-2" />
    <div class="flex gap-2 justify-end items-start lg:col-start-3">
      <ThemePicker />
      <LanguagePicker />
    </div>
  </div>
</header>
