---
import Card from "@/components/Card.astro";
import Logo from "@/components/Logo.astro";
import Countdown from "@/components/Countdown.astro";
import { i18n } from "@/i18n/utils";

const { translate: t } = i18n(Astro);

const { title } = Astro.props as {
  title: string;
};
---

<div
  class="flex-1 flex flex-col justify-center items-center mb-30 w-full h-full px-8"
>
  <div
    class="flex-1 flex flex-col items-center lg:justify-center gap-12 h-full"
  >
    <div class="text-center text-shadow-md/25">
      <h1 aria-label="DELTA" role="img" class="contents">
        <Logo class="lg:text-9xl sm:text-8xl text-7xl" animate />
      </h1>
      <Countdown class="lg:text-4xl text-2xl" />
    </div>

    <Card
      class="lg:max-w-full p-8 flex flex-col gap-8 text-center sm:aspect-square max-w-fit sm:max-w-none min-h-fit w-full max-h-full sm:h-fit sm:w-2/3 xl:aspect-4/5"
    >
      <h2
        class="text-5xl font-bold tracking-tight text-brand-primary text-shadow-sm/25 dark:text-shadow-none"
      >
        {title}
      </h2>

      <slot class="text-balance" />

      <p>
        <a
          href="/"
          class="text-backdrop-content-highlight hover:text-backdrop-content-highlight/80"
          >{t("errorPage.return")}</a
        >
      </p>
    </Card>
  </div>
</div>
