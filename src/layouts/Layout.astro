---
import { Image } from "astro:assets";

import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import "@/styles/global.css";
import { getLang } from "@/i18n/utils";
import { twMerge } from "tailwind-merge";

interface Props {
  title: string;
  description: string;
  backgroundImage?: ImageMetadata;
  class?: string;
}

const {
  title,
  description,
  backgroundImage,
  class: className,
  ...rest
} = Astro.props;
const lang = getLang(Astro.cookies);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/delta-delta.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>

    <script is:inline>
      const stored = localStorage.getItem("theme");
      const prefersDark = window.matchMedia(
        "(prefers-color-scheme: dark)",
      ).matches;

      const activeTheme =
        stored === "dark" || (!stored && prefersDark) ? "dark" : "light";

      document.documentElement.setAttribute("data-theme", activeTheme);
      document.documentElement.classList.add("js");
    </script>
  </head>

  <body>
    <div class="relative isolate flex min-h-dvh flex-col gap-6 lg:gap-0">
      {
        backgroundImage && (
          <div class="absolute inset-x-0 top-0 h-dvh -z-10 pointer-events-none select-none overflow-hidden">
            <Image
              src={backgroundImage}
              alt="Background Cover"
              class="h-full w-full object-cover blur-sm scale-105"
            />
            <div class="absolute inset-x-0 bottom-0 h-32 bg-gradient-to-b from-transparent to-backdrop" />
          </div>
        )
      }

      <Header />

      <main
        class={twMerge(
          "flex flex-col items-center justify-center w-full flex-1 shrink-0",
          className,
        )}
        {...rest}
      >
        <slot />
      </main>
    </div>

    <Footer />

    <script>
      // JS-toggled fold panels: works in every browser, unlike ::details-content.
      document.addEventListener("click", (event) => {
        const button = (
          event.target as Element | null
        )?.closest<HTMLButtonElement>("[data-fold-toggle]");
        if (!button) return;

        const id = button.getAttribute("aria-controls");
        const wrap = id ? document.getElementById(id) : null;
        if (!wrap) return;

        const open = wrap.hasAttribute("data-open");
        if (open) {
          wrap.removeAttribute("data-open");
          wrap.inert = true;
          button.setAttribute("aria-expanded", "false");
        } else {
          wrap.setAttribute("data-open", "");
          wrap.inert = false;
          button.setAttribute("aria-expanded", "true");
        }
      });

      // Scroll reveals: content below the first screen fades in once it
      // enters the viewport. The hidden state is gated behind `html.js`.
      const reveals = document.querySelectorAll(".reveal");
      if (reveals.length > 0) {
        const revealObserver = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                revealObserver.unobserve(entry.target);
              }
            }
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.1 },
        );
        reveals.forEach((element) => revealObserver.observe(element));
      }

      // Timeline rail: fill the vertical line as the reader scrolls through
      // the timeline. Direct, rAF-throttled updates so it tracks the scroll
      // position instead of animating on its own.
      const timelines =
        document.querySelectorAll<HTMLElement>("[data-timeline]");
      for (const timeline of timelines) {
        const rail = timeline.querySelector<HTMLElement>(
          "[data-timeline-rail]",
        );
        if (!rail) continue;

        let ticking = false;
        const update = () => {
          ticking = false;
          const rect = timeline.getBoundingClientRect();
          const viewport = window.innerHeight;
          const start = viewport * 0.6;
          const end = viewport * 0.4;
          const passed = start - rect.top;
          const progress = Math.min(
            1,
            Math.max(0, passed / (rect.height + start - end)),
          );
          rail.style.setProperty("--rail-progress", progress.toFixed(4));
        };
        const onScroll = () => {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(update);
          }
        };
        update();
        window.addEventListener("scroll", onScroll, { passive: true });
        window.addEventListener("resize", onScroll);
      }
    </script>
  </body>
</html>
