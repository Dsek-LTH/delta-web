---
import { Image } from "astro:assets";

import Footer from "@/components/Footer.astro";
import LanguagePicker from "@/components/LanguagePicker.astro";
import "@/styles/global.css";
import { getLangFromUrl } from "@/i18n/utils";

interface Props {
  backgroundImage?: ImageMetadata;
  class?: String;
}

const { backgroundImage, class: className, ...rest } = Astro.props;
const lang = getLangFromUrl(Astro.url);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/delta-delta.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>&gt;&nbsp;DELT&Delta;&#95; | D-sektionen inom TLTH</title>
  </head>

  <body
    class="relative isolate bg-slate-900 font-inter text-amber-50 min-h-screen flex flex-col overflow-x-hidden"
  >
    {
      backgroundImage && (
        <div class="absolute inset-0 -z-1337 pointer-events-none select-none">
          <Image
            src={backgroundImage}
            alt="Background Cover"
            class="w-full h-full object-cover blur-sm fixed"
          />
        </div>
      )
    }

    <header class="fixed flex justify-end w-full z-1337 p-2">
      <!-- ☀️🌙 -->
      <LanguagePicker />
    </header>

    <main
      class:list={[
        "flex flex-col items-center justify-center w-full min-h-dvh shrink-0",
        className,
      ]}
      {...rest}
    >
      <slot />
    </main>

    <Footer />
  </body>
</html>
