---
import Footer from "@/components/Footer.astro";
import LanguagePicker from "@/components/LanguagePicker.astro";
import ThemePicker from "@/components/ThemePicker.astro";
import "@/styles/global.css";
import cover from "@/assets/tekfok26_0003.webp";
import { Image } from "astro:assets";

const { class: className, ...rest } = Astro.props;

import { getLangFromUrl } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/delta-delta.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>&gt;&nbsp;DELT&Delta;&#95; | D-sektionen inom TLTH</title>

    <script is:inline>
      const stored = localStorage.getItem("theme");
      const prefersDark = window.matchMedia(
        "(prefers-color-scheme: dark)",
      ).matches;

      const activeTheme =
        stored === "dark" || (!stored && prefersDark) ? "dark" : "light";

      document.documentElement.setAttribute("data-theme", activeTheme);
    </script>
  </head>

  <body
    class="relative isolate flex flex-col bg-backdrop text-backdrop-content font-inter min-h-screen overflow-x-hidden"
  >
    <div
      class="absolute inset-0 -z-1337 pointer-events-none select-none overflow-hidden"
    >
      <Image
        src={cover}
        alt="Background Cover"
        class="w-full h-full object-cover blur-sm fixed scale-105"
      />
    </div>

    <header
      class="lg:fixed sticky top-0 flex items-start justify-end gap-4 w-full z-1337 p-2"
    >
      <!-- ☀️🌙 -->
      <ThemePicker />
      <LanguagePicker />
    </header>

    <main
      class:list={[
        "flex flex-col items-center justify-center w-full min-h-dvh shrink-0",
        className,
      ]}
      {...rest}
    >
      <slot />
    </main>

    <Footer />
  </body>
</html>
